<Project>
  <PropertyGroup>
    <Version>1.5.25</Version>
    <Authors>BroadcastRouter Contributors</Authors>
    <Product>BroadcastRouter</Product>
    <Description>Production Wowza-to-Blackmagic DeckLink routing control for Windows.</Description>
    <RepositoryUrl>https://github.com/abdlmalekluttee/BroadcastRouter</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
