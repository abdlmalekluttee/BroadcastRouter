@page "/denied"
@attribute [Authorize]

<PageTitle>Access denied · BroadcastRouter</PageTitle>
<div class="empty-state access-denied">
    <h1>Administrator access required</h1>
    <AuthorizeView Context="authenticationState"><Authorized>
        <p>This page requires the Administrator role. You are signed in as @authenticationState.User.Identity?.Name (@(authenticationState.User.IsInRole("Operator") ? "Operator" : "non-administrator")).</p>
    </Authorized></AuthorizeView>
    <a class="btn" href="/">Return to dashboard</a>
</div>
