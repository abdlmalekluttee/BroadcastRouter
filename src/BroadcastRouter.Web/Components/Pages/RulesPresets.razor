@page "/rules"
@attribute [Authorize(Roles = "Administrator")]
@rendermode InteractiveServer
@inject RouterCoordinator Coordinator
@inject AuthorizedRouterCommands Commands
@inject IJSRuntime JS

<PageTitle>Rules &amp; Presets · BroadcastRouter</PageTitle>
<div class="page-head"><div><h1>Rules and presets</h1><p class="lead">Rules are evaluated by order using bounded wildcards or <span class="mono">regex:</span> patterns with a timeout.</p></div><div class="actions"><button class="btn" @onclick="AddRule">Add rule</button><button class="btn" @onclick="AddPreset">Add preset</button><button class="btn primary" @onclick="Save">Save changes</button></div></div>
@if (!string.IsNullOrWhiteSpace(message)) { <div class="notice @messageClass" role="status">@message</div> }

<div class="panel"><div class="panel-head"><div><h2>Routing rules</h2><span class="secondary-text">Each rule uses a responsive editor; lower order numbers run first.</span></div></div><div class="panel-body rule-list">
@foreach (var rule in settings.Rules.OrderBy(x => x.Order))
{
    <article class="rule-editor" @key="rule.Id">
        <header class="rule-editor-head"><label class="check compact"><InputCheckbox aria-label="@($"Enable rule {rule.Name}")" @bind-Value="rule.Enabled" /> Enabled</label><strong>@rule.Name</strong><button class="btn small danger" @onclick="() => RemoveRule(rule)">Remove rule</button></header>
        <div class="rule-fields">
            <div class="form-group"><label>Order</label><InputNumber aria-label="@($"Order for rule {rule.Name}")" @bind-Value="rule.Order" /></div>
            <div class="form-group rule-name-field"><label>Rule name</label><InputText aria-label="Rule name" @bind-Value="rule.Name" /></div>
            <div class="form-group"><label>Server pattern</label><InputText aria-label="@($"Server pattern for {rule.Name}")" @bind-Value="rule.ServerPattern" /></div>
            <div class="form-group"><label>Application pattern</label><InputText aria-label="@($"Application pattern for {rule.Name}")" @bind-Value="rule.ApplicationPattern" /></div>
            <div class="form-group"><label>Instance pattern</label><InputText aria-label="@($"Instance pattern for {rule.Name}")" @bind-Value="rule.InstancePattern" /></div>
            <div class="form-group"><label>Stream pattern</label><InputText aria-label="@($"Stream pattern for {rule.Name}")" @bind-Value="rule.StreamPattern" /></div>
            <div class="form-group"><label>Codec (optional)</label><InputText aria-label="@($"Codec for {rule.Name}")" @bind-Value="rule.Codec" placeholder="Any codec" /></div>
            <div class="form-group"><label>Tag (optional)</label><InputText aria-label="@($"Tag for {rule.Name}")" @bind-Value="rule.Tag" placeholder="Any tag" /></div>
            <div class="form-group"><label>Output preset</label><select aria-label="Preset for @rule.Name" @bind="rule.PresetId">@foreach (var preset in settings.Presets) { <option value="@preset.Id">@preset.Name</option> }</select></div>
            <div class="form-group"><label>Fixed output (optional)</label><select aria-label="@($"Fixed output for {rule.Name}")" @bind="rule.FixedPortId"><option value="">Automatic</option>@if(IsMissingPort(rule.FixedPortId)){<option value="@rule.FixedPortId">Saved output unavailable (@DeckLinkDisplayName.ShortIdentity(rule.FixedPortId))</option>}@foreach(var port in OrderedPorts()){<option value="@port.StableId">@DeckLinkDisplayName.Full(port)</option>}</select></div>
            <div class="form-group"><label>Output group (optional)</label><InputText aria-label="@($"Port group for {rule.Name}")" @bind-Value="rule.PortGroup" placeholder="Any group" /></div>
            <div class="form-group"><label>Priority adjustment</label><InputNumber aria-label="@($"Priority adjustment for {rule.Name}")" @bind-Value="rule.PriorityAdjustment" /></div>
            <div class="form-group rule-lock-field"><label>Assignment ownership</label><label class="check compact"><InputCheckbox aria-label="@($"Lock assignments for {rule.Name}")" @bind-Value="rule.LockAssignment" /> Lock matched routes</label></div>
        </div>
    </article>
}
@if (settings.Rules.Count == 0) { <div class="empty-state">No rule matches means automatic assignment with the first preset.</div> }
</div></div>

<div class="panel"><div class="panel-head"><div><h2>Output presets</h2><span class="secondary-text">Saved presets are available on manual routes and route reassignment.</span></div></div><div class="panel-body preset-list">
@foreach (var preset in settings.Presets)
{
    <article class="preset-editor" @key="preset.Id">
        <header class="preset-editor-head"><div><strong>@preset.Name</strong><span class="secondary-text mono">@preset.Id</span></div><button class="btn small danger" disabled="@(settings.Presets.Count == 1)" @onclick="() => RemovePreset(preset)">Remove preset</button></header>
        <div class="preset-fields">
            <div class="form-group"><label>Preset ID</label><InputText aria-label="Preset ID" @bind-Value="preset.Id" /></div>
            <div class="form-group"><label>Display name</label><InputText aria-label="@($"Preset name for {preset.Id}")" @bind-Value="preset.Name" /></div>
            <div class="form-group"><label>Raster</label><div class="number-pair"><InputNumber aria-label="@($"Width for {preset.Name}")" @bind-Value="preset.Width" /><span>×</span><InputNumber aria-label="@($"Height for {preset.Name}")" @bind-Value="preset.Height" /></div></div>
            <div class="form-group"><label>Frame rate</label><div class="number-pair"><InputNumber aria-label="@($"Frame-rate numerator for {preset.Name}")" @bind-Value="preset.FrameRateNumerator" /><span>/</span><InputNumber aria-label="@($"Frame-rate denominator for {preset.Name}")" @bind-Value="preset.FrameRateDenominator" /></div></div>
            <div class="form-group"><label>Scan</label><select aria-label="Scan type for @preset.Name" value="@OutputScanSelection.Format(preset.Interlaced)" @onchange="eventArgs => SetScan(preset, eventArgs.Value?.ToString())"><option value="@OutputScanSelection.Progressive">Progressive</option><option value="@OutputScanSelection.Interlaced">Interlaced</option></select></div>
            <div class="form-group"><label>Pixel format</label><InputText aria-label="@($"Pixel format for {preset.Name}")" @bind-Value="preset.PixelFormat" /></div>
            <div class="form-group"><label>Input buffer (MB)</label><InputNumber aria-label="@($"Buffer size for {preset.Name}")" @bind-Value="preset.BufferSizeMegabytes" /></div>
            <div class="form-group preset-toggles"><label>Audio and latency</label><div class="toggle-row"><label class="check compact"><InputCheckbox aria-label="@($"Include audio for {preset.Name}")" @bind-Value="preset.IncludeAudio" /> Audio</label><label class="check compact"><InputCheckbox aria-label="@($"Use low latency for {preset.Name}")" @bind-Value="preset.LowLatency" /> Low latency</label></div></div>
            <div class="form-group standby-fields"><label>Standby</label><div class="standby-row"><InputSelect aria-label="@($"Standby mode for {preset.Name}")" @bind-Value="preset.StandbyMode"><option value="Black">Black</option><option value="TestPattern">Color bars</option><option value="FreezeLastFrame">Freeze</option><option value="File">File</option><option value="StandbySource">Source</option></InputSelect><InputText aria-label="@($"Standby value for {preset.Name}")" @bind-Value="preset.StandbyValue" placeholder="Optional file or source" /></div></div>
        </div>
    </article>
}
</div></div>

@code {
    private OperatorSettings settings = null!;
    private string message = "";
    private string messageClass = "";
    protected override void OnInitialized() => settings = Coordinator.GetSettings();
    private void AddRule() => settings.Rules.Add(new RoutingRuleProfile { Order = settings.Rules.Select(x => x.Order).DefaultIfEmpty(0).Max() + 10, PresetId = settings.Presets.First().Id });
    private void AddPreset() => settings.Presets.Add(new OutputPresetProfile { Id = UniqueIdGenerator.Next("preset", settings.Presets.Select(x => x.Id)), Name = "New preset" });
    private IOrderedEnumerable<DeckLinkPort> OrderedPorts() => Coordinator.Snapshot.Ports
        .Where(port => port.IsOutputPort)
        .OrderBy(DeckLinkDisplayName.Card, StringComparer.OrdinalIgnoreCase)
        .ThenBy(DeckLinkDisplayName.Connector, StringComparer.OrdinalIgnoreCase);
    private bool IsMissingPort(string stableId) => !string.IsNullOrWhiteSpace(stableId) && !Coordinator.Snapshot.Ports.Any(port => port.IsOutputPort && port.StableId.Equals(stableId, StringComparison.OrdinalIgnoreCase));
    private static void SetScan(OutputPresetProfile preset, string? value) { if (OutputScanSelection.TryParse(value, out var interlaced)) preset.Interlaced = interlaced; }
    private async Task RemoveRule(RoutingRuleProfile rule) { if (await JS.InvokeAsync<bool>("confirm", $"Remove routing rule '{rule.Name}'? Automatic assignments may change after save.")) settings.Rules.Remove(rule); }
    private async Task RemovePreset(OutputPresetProfile preset)
    {
        var references = settings.Rules.Count(rule => rule.PresetId.Equals(preset.Id, StringComparison.OrdinalIgnoreCase));
        if (references > 0) { message = $"Preset '{preset.Name}' is referenced by {references} routing rule(s). Reassign or remove those rules first."; messageClass = "danger"; return; }
        var routeReferences = Coordinator.Snapshot.Routes.Count(route => route.State is not RouteState.Released and not RouteState.Disabled && route.PresetId.Equals(preset.Id, StringComparison.OrdinalIgnoreCase));
        if (routeReferences > 0) { message = $"Preset '{preset.Name}' is used by {routeReferences} active or waiting route(s). Reassign or stop those routes first."; messageClass = "danger"; return; }
        if (await JS.InvokeAsync<bool>("confirm", $"Remove output preset '{preset.Name}'?")) settings.Presets.Remove(preset);
    }
    private async Task Save() { try { var result = await Commands.SaveSettingsAsync(settings); settings = result.Settings; message = $"Configuration saved and applied successfully at {result.AppliedAt.ToLocalTime():yyyy-MM-dd HH:mm:ss}. Backend revision {result.ConfigurationRevision} confirmed."; messageClass = "success"; } catch (Exception ex) { message = ex.Message; messageClass = "danger"; } }
}
