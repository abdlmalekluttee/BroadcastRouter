@page "/logs"
@inject RouterCoordinator Coordinator
@implements IDisposable

<PageTitle>Logs &amp; Diagnostics · BroadcastRouter</PageTitle>
<div class="page-head"><div><h1>Logs and diagnostics</h1><p class="lead">Searchable structured history with credential redaction and a sanitized support package.</p></div><div class="actions"><a class="btn" href="/health" target="_blank" rel="noopener">Health JSON <span class="new-tab-label">New tab</span></a><AuthorizeView Roles="Administrator"><Authorized><a class="btn primary" href="/diagnostics/package">Download diagnostics</a></Authorized></AuthorizeView></div></div>
<div class="grid two-col">
    <div class="panel"><div class="panel-head logs-panel-head"><h2>Structured logs</h2><form class="log-filters" @onsubmit="Load" @onsubmit:preventDefault><input data-operator-filter class="log-search" aria-label="Search logs" @bind="search" placeholder="Search messages, category, source…" /><select aria-label="Minimum log level" @bind="level"><option value="all">All levels</option><option value="error">Error</option><option value="warning">Warning</option><option value="info">Info</option></select><select aria-label="Log time window" @bind="timeWindow"><option value="15">Last 15 minutes</option><option value="60">Last hour</option><option value="360">Last 6 hours</option><option value="1440">Last 24 hours</option><option value="0">All loaded</option></select><label class="check compact live-tail"><input type="checkbox" @bind="liveTail" @bind:after="LiveTailChanged" /> Live tail</label><button class="btn small" disabled="@loading">@(loading ? "Loading…" : "Search")</button></form></div><div class="table-wrap virtual-table"><table><thead><tr><th>Time</th><th>Level</th><th>Category</th><th>Message</th><th>Source / Correlation</th></tr></thead><tbody>
    <Virtualize TItem="StructuredLogEntry" Items="@FilteredLogs" Context="log" ItemSize="48" SpacerElement="tr"><ItemContent><tr><td class="mono">@log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td><td class="log-@log.Level.ToLowerInvariant()">@log.Level</td><td>@log.Category</td><td class="log-message">@log.Message</td><td class="mono"><span class="secondary-text">@log.SourceId</span><span class="secondary-text">@log.CorrelationId</span></td></tr></ItemContent></Virtualize>
    @if(FilteredLogs.Count == 0){<tr><td colspan="5"><div class="empty-state">No matching log entries.</div></td></tr>}
    </tbody></table></div></div>
    <div>
        <div class="panel"><div class="panel-head"><h2>Media validation</h2><BroadcastRouter.Web.Components.Shared.StateBadge Value="Coordinator.Snapshot.ToolValidation.State" /></div><div class="panel-body"><ul class="validation-list">@foreach(var finding in Coordinator.Snapshot.ToolValidation.Findings){<li class="@(finding.StartsWith("PASS") ? "pass" : finding.StartsWith("FAIL") ? "fail" : "warn")">@finding</li>}</ul></div></div>
        <div class="panel"><div class="panel-head"><h2>Support package contents</h2></div><div class="panel-body"><ul><li>Sanitized runtime snapshot and settings revision</li><li>Redacted recent structured and configuration-audit logs</li><li>SQLite integrity result (no database copy)</li><li>FFmpeg/FFprobe validation findings</li><li>Opaque route/output identifiers, reference status, states, and recent failures</li></ul><p class="secondary-text">Credentials, internal addresses, topology names, media paths, and the production database are omitted or redacted.</p></div></div>
        <div class="panel"><div class="panel-head"><h2>Failure summary</h2></div><div class="panel-body">@foreach(var route in Coordinator.Snapshot.Routes.Where(x => x.FailureCategory is not null)){<div class="notice danger"><strong>@route.SourceName · @route.FailureCategory</strong><br />@route.FailureMessage</div>}@if(!Coordinator.Snapshot.Routes.Any(x => x.FailureCategory is not null)){<p class="secondary-text">No current route failures.</p>}</div></div>
    </div>
</div>
<div class="panel"><div class="panel-head"><div><h2>Configuration audit</h2><span class="secondary-text">Confirmed operator changes, identity migrations, rediscovery, and service-start events.</span></div></div><div class="table-wrap"><table><thead><tr><th>Time</th><th>Event</th><th>Card / port</th><th>Previous</th><th>New</th><th>Responsible</th><th>Reason / backend</th><th>Stream</th></tr></thead><tbody>
<Virtualize TItem="ConfigurationAuditEntry" Items="@audit" Context="entry" ItemSize="56" SpacerElement="tr"><ItemContent><tr><td class="mono">@entry.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td><td>@entry.EventType</td><td><strong>@entry.CardName</strong><span class="secondary-text">@entry.PortName</span><span class="secondary-text mono">@entry.EntityId</span></td><td class="audit-state">@entry.PreviousState</td><td class="audit-state">@entry.NewState</td><td>@entry.Actor</td><td class="audit-reason">@entry.Reason<br /><span class="secondary-text">@entry.BackendStatus</span></td><td class="mono">@entry.SourceId</td></tr></ItemContent></Virtualize>
@if(audit.Count == 0){<tr><td colspan="8"><div class="empty-state">No configuration audit entries have been recorded yet.</div></td></tr>}
</tbody></table></div></div>

@code {
    private List<StructuredLogEntry> logs = []; private List<ConfigurationAuditEntry> audit = []; private string search = ""; private string level = "all"; private int timeWindow = 60; private bool liveTail; private bool loading; private readonly CancellationTokenSource disposeToken = new();
    private List<StructuredLogEntry> FilteredLogs => logs.Where(log => MatchesLevel(log.Level) && (timeWindow == 0 || log.Timestamp >= DateTimeOffset.UtcNow.AddMinutes(-timeWindow))).ToList();
    protected override async Task OnInitializedAsync() { await Load(); _ = TailLoop(disposeToken.Token); }
    private bool MatchesLevel(string value) => level switch { "error" => value.Equals("Error", StringComparison.OrdinalIgnoreCase) || value.Equals("Critical", StringComparison.OrdinalIgnoreCase), "warning" => value.Equals("Warning", StringComparison.OrdinalIgnoreCase), "info" => value.Equals("Information", StringComparison.OrdinalIgnoreCase) || value.Equals("Info", StringComparison.OrdinalIgnoreCase), _ => true };
    private async Task Load() { if(loading) return; try { loading = true; logs = (await Coordinator.ReadLogsAsync(search, 1000)).ToList(); audit = (await Coordinator.ReadConfigurationAuditAsync(1000)).ToList(); } finally { loading = false; } }
    private Task LiveTailChanged() => liveTail ? Load() : Task.CompletedTask;
    private async Task TailLoop(CancellationToken cancellationToken) { using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2)); try { while(await timer.WaitForNextTickAsync(cancellationToken)) if(liveTail) await InvokeAsync(async () => { await Load(); StateHasChanged(); }); } catch(OperationCanceledException) { } }
    public void Dispose() { disposeToken.Cancel(); disposeToken.Dispose(); }
}
