@page "/outputs"
@rendermode InteractiveServer
@inject RouterCoordinator Coordinator
@inject AuthorizedRouterCommands Commands
@inject DeckLinkAssetCatalog AssetCatalog
@implements IDisposable

<PageTitle>DeckLink Outputs · BroadcastRouter</PageTitle>
<div class="page-head"><div><h1>DeckLink ports</h1><p class="lead">Only connectors explicitly marked as output ports can be routed. Idle output ports show their configured standby screen.</p></div><AuthorizeView Roles="Administrator"><Authorized><div class="actions"><a class="btn" href="/settings">Configure ports</a><button class="btn" @onclick='() => Commands.ExecuteAsync("rescan")'>Rescan hardware</button></div></Authorized></AuthorizeView></div>
@if (!snapshot.SimulationMode && !snapshot.ToolValidation.CanStartHardwareRoutes) { <div class="notice danger">DeckLink starts are blocked: @snapshot.ToolValidation.Findings.LastOrDefault(x => x.StartsWith("FAIL"))</div> }
@if (!AssetCatalog.Status.Installed)
{
    <div class="notice asset-pack-notice"><strong>DeckLink visual asset pack is not installed.</strong> Technical identity and routing remain fully operational. Install the optional operator-supplied pack under <span class="mono">data\decklink-assets</span> to add model images and connector diagrams.</div>
}

@foreach (var card in CardGroups())
{
    var first = card.Ports[0];
    <section class="panel decklink-card" @key="card.Key">
        <div class="panel-head decklink-card-head">
            <div><span class="stat-label">Physical DeckLink card</span><h2>@DeckLinkDisplayName.Card(first)</h2><span class="secondary-text">@first.ModelName · @card.Ports.Count connector(s)</span></div>
            @if (first.DeviceGroupId is not null) { <span class="badge success">Persistent identity @DeckLinkDisplayName.ShortIdentity(first.DeviceGroupId)</span> }
            else { <span class="badge warning">Fallback identity</span> }
        </div>
        <div class="panel-body">
        <BroadcastRouter.Web.Components.Shared.DeckLinkCardVisual CardKey="@card.Key" Ports="@card.Ports" Routes="@snapshot.Routes" />
        <div class="grid port-grid">
        @foreach (var port in card.Ports)
        {
            var route = snapshot.Routes.FirstOrDefault(x => x.PortId == port.StableId && x.State != RouteState.Released);
            var standby = snapshot.Standbys?.FirstOrDefault(value => value.PortId.Equals(port.StableId, StringComparison.OrdinalIgnoreCase));
            <article class="card port-card @(route is null ? "" : "occupied")" @key="port.StableId">
                <span class="connector"></span><div class="stat-label">Connector @(port.SubdeviceIndex + 1)</div><h2 style="margin-top:8px">@DeckLinkDisplayName.Connector(port)</h2>
                <span class="secondary-text">@DeckLinkDisplayName.Full(port)</span><div class="actions" style="margin-top:16px"><span class="badge @(port.IsOutputPort ? "success" : "warning")">@(port.IsOutputPort ? "Output port" : "Input / excluded")</span><BroadcastRouter.Web.Components.Shared.StateBadge Value="@(port.IsAvailable ? (route is null ? "Available" : "Reserved") : "Unavailable")" /><span class="badge @ReferenceClass(port)">@ReferenceSummary(port)</span>@if(standby is not null){<BroadcastRouter.Web.Components.Shared.StateBadge Value="standby.State" />}</div>
                <dl><dt>Port group</dt><dd>@(string.IsNullOrWhiteSpace(port.PortGroup) ? "Default" : port.PortGroup) @(port.Reserved ? "· reserved from automatic routing" : "")</dd><dt>Genlock / reference</dt><dd>@ReferenceDetail(port)</dd><dt>Mapping confidence</dt><dd>@port.IdentityConfidence</dd><dt>Supported modes</dt><dd>@(port.SupportedModes.Count == 0 ? "Query not exposed / verified when FFmpeg starts" : string.Join(", ", port.SupportedModes.Select(Mode)))</dd></dl>
                <details class="technical-identity"><summary>Technical identity</summary><dl><dt>FFmpeg address</dt><dd class="mono">@port.FfmpegName</dd><dt>Connector stable ID</dt><dd class="mono">@port.StableId</dd>@if(port.PersistentId is not null){<dt>Persistent connector ID</dt><dd class="mono">@port.PersistentId</dd>}@if(port.DeviceGroupId is not null){<dt>Physical card identity</dt><dd class="mono">@port.DeviceGroupId</dd>}@if(port.TopologicalId is not null){<dt>Current topology ID (not saved)</dt><dd class="mono">@port.TopologicalId</dd>}</dl></details>
                @if (route is not null) { <div class="notice success" style="margin:12px 0 0"><strong>@route.SourceName</strong><br />@route.PresetId · @(route.Locked ? "locked" : "unlocked")</div> }
                @if (standby is not null) { <div class="standby-summary"><strong>@standby.Summary</strong>@if(!string.IsNullOrWhiteSpace(standby.ErrorMessage)){<span class="secondary-text">@standby.ErrorMessage</span>}</div> }
            </article>
        }
        </div></div>
    </section>
}
@if (snapshot.Ports.Count == 0) { <div class="panel"><div class="empty-state">No DeckLink outputs enumerated. Configure a DeckLink-enabled FFmpeg build and install Blackmagic Desktop Video, then rescan.</div></div> }
@if (snapshot.Ports.Any(port => port.PersistentId is null))
{
    <div class="notice warning" style="margin-top:18px">One or more outputs do not expose a unique Blackmagic persistent ID. Re-verify those fallback mappings after Desktop Video upgrades, topology changes, or card replacement.</div>
}
else if (snapshot.Ports.Count > 0)
{
    <div class="notice success" style="margin-top:18px">All outputs use Blackmagic persistent hardware IDs. Card names, connector names, and route references remain attached when identical cards move between PCIe slots.</div>
}

@code {
    private RouterSnapshot snapshot = null!;
    protected override void OnInitialized() { snapshot = Coordinator.Snapshot; Coordinator.Changed += Changed; }
    private void Changed() => _ = InvokeAsync(() => { snapshot = Coordinator.Snapshot; StateHasChanged(); });
    private IReadOnlyList<CardView> CardGroups() => snapshot.Ports
        .GroupBy(port => port.DeviceGroupId ?? $"legacy-card-{port.CardIndex}", StringComparer.OrdinalIgnoreCase)
        .Select(group => new CardView(group.Key, group.OrderBy(port => port.SubdeviceIndex).ToArray()))
        .OrderBy(card => DeckLinkDisplayName.Card(card.Ports[0]), StringComparer.OrdinalIgnoreCase)
        .ToArray();
    public void Dispose() => Coordinator.Changed -= Changed;
    private static string Mode(VideoMode m) => $"{m.Width}×{m.Height}@{m.FramesPerSecond:0.##} {m.PixelFormat}";
    private static string ReferenceClass(DeckLinkPort port) => port.HasReferenceInput switch { false => "", true when port.ReferenceSignalLocked == true => "success", true when port.ReferenceSignalLocked == false => "warning", _ => "" };
    private static string ReferenceSummary(DeckLinkPort port) => port.HasReferenceInput switch { false => "Reference not supported", true when port.ReferenceSignalLocked == true => "Reference locked", true when port.ReferenceSignalLocked == false => "Reference unlocked", _ => "Reference unknown" };
    private static string ReferenceDetail(DeckLinkPort port) => port.HasReferenceInput switch { false => "This connector/card has no reference input and operates free-running.", true when port.ReferenceSignalLocked == true => "Blackmagic SDK reports the reference input is locked.", true when port.ReferenceSignalLocked == false => "Reference input is not locked. Stream availability remains independent and the route will continue retrying.", _ => "The installed driver did not expose reference-lock status." };
    private sealed record CardView(string Key, IReadOnlyList<DeckLinkPort> Ports);
}
