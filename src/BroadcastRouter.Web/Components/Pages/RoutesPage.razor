@page "/routes"
@using BroadcastRouter.Application
@inject RouterCoordinator Coordinator
@inject AuthorizedRouterCommands Commands
@inject DeckLinkAssetCatalog AssetCatalog
@inject OperatorErrorMessage OperatorErrors
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Routes · BroadcastRouter</PageTitle>
<ConfirmDialog @ref="confirmDialog" />
<div class="page-head">
    <div><h1>Routes / Routing Matrix</h1><p class="lead">Every route acquires one atomic port lease before FFmpeg is allowed to start.</p></div>
    <AuthorizeView Roles="Administrator"><Authorized><div class="actions"><button class="btn" disabled="@pageBusy" @onclick='() => Run("rescan")'>@(pageBusy ? "Reconciling…" : "Reconcile now")</button><button class="btn danger" disabled="@pageBusy" @onclick='() => Run("emergency-stop")'>@(pageBusy ? "Stopping…" : "Emergency stop")</button></div></Authorized></AuthorizeView>
</div>
<NoticeBoard Severity="danger" @bind-Message="error" />
<NoticeBoard Severity="success" @bind-Message="confirmation" />
<UndoBar Message="All BroadcastRouter outputs were stopped." ActionLabel="Undo emergency stop" ExpiresAt="@emergencyUndoExpiresAt" Busy="@pageBusy" UndoRequested="UndoEmergencyStop" />
<div class="filter-bar" role="search">
    <label class="filter-search"><span>Filter routes</span><input data-operator-filter aria-label="Filter routes by source name or ID" value="@Query" @oninput="UpdateQuery" placeholder="Name or source ID" /></label>
    <div class="filter-chips" aria-label="Filter routes by state">@foreach(var option in RouteFilterOptions){<button type="button" class="filter-chip @(StateFilter == option.Value ? "active" : "")" aria-pressed="@(StateFilter == option.Value)" @onclick="() => SetStateFilter(option.Value)">@option.Label</button>}</div>
    <AuthorizeView Roles="Administrator"><Authorized><div class="bulk-actions" aria-label="Selected route actions"><span>@selectedRouteIds.Count selected</span><button class="btn small" disabled="@(selectedRouteIds.Count == 0 || pageBusy)" @onclick='() => BulkAction("restart")'>Restart</button><button class="btn small" disabled="@(selectedRouteIds.Count == 0 || pageBusy)" @onclick='() => BulkAction("stop")'>Stop</button><button class="btn small danger" disabled="@(selectedRouteIds.Count == 0 || pageBusy)" @onclick='() => BulkAction("release")'>Release</button></div></Authorized></AuthorizeView>
</div>

@if (outputCardGroups.Count > 0)
{
    <details class="panel route-hardware-guide">
        <summary><span><strong>Physical output guide</strong><small>Match software outputs to the installed card and connector before changing a route.</small></span><span class="badge @(AssetCatalog.Status.Installed ? "success" : "neutral")">@(AssetCatalog.Status.Installed ? "Visual pack loaded" : "Technical view")</span></summary>
        <div class="panel-body route-hardware-grid">
        @foreach (var card in outputCardGroups)
        {
            <div class="route-hardware-card" @key="card.Key"><h3>@DeckLinkDisplayName.Card(card.Ports[0])</h3><BroadcastRouter.Web.Components.Shared.DeckLinkCardVisual CardKey="@card.Key" Ports="@card.Ports" Routes="@snapshot.Routes" Compact="true" ShowTechnicalImages="false" /></div>
        }
        </div>
    </details>
}

<div class="routing-workspace @density">
    <section class="panel matrix-panel">
        <div class="panel-head"><div><h2>Source × output matrix</h2><span class="secondary-text">Select a cell to inspect it. Assignment starts only after Save assignment in the detail panel.</span></div><button class="btn small" type="button" @onclick="ToggleDensity">Density: @(density == "compact" ? "Compact" : "Comfortable")</button></div>
        <div class="table-wrap matrix-scroll">
            <table class="routing-matrix">
                <thead>
                    <tr><th class="matrix-source-column" rowspan="2" scope="col">Source</th>@foreach(var card in matrixCardGroups){<th colspan="@card.Ports.Count" scope="colgroup">@DeckLinkDisplayName.Card(card.Ports[0])</th>}</tr>
                    <tr>@foreach(var port in matrixPorts){<th scope="col" class="@(!port.IsAvailable ? "port-unavailable" : "")"><button type="button" class="matrix-header-button" @onclick="() => SelectPortDetail(port)">@DeckLinkDisplayName.Connector(port)<span>SDI @(port.SubdeviceIndex + 1)</span></button></th>}</tr>
                </thead>
                <tbody>
                    @for(var rowIndex = 0; rowIndex < matrixRows.Count; rowIndex++)
                    {
                        var row = matrixRows[rowIndex];
                        <tr>
                            <th scope="row" class="matrix-source-column"><div class="matrix-source"><AuthorizeView Roles="Administrator"><Authorized><input type="checkbox" aria-label="Select route @row.Name" checked="@selectedRouteIds.Contains(row.Id)" disabled="@(row.Route is null)" @onchange="args => ToggleRoute(row.Id, args.Value)" /></Authorized></AuthorizeView><button type="button" @onclick="() => SelectSourceDetail(row)"><strong>@row.Name</strong><span>@row.Id</span></button></div></th>
                            @for(var columnIndex = 0; columnIndex < matrixPorts.Count; columnIndex++)
                            {
                                var port = matrixPorts[columnIndex];
                                var r = rowIndex; var c = columnIndex;
                                var cellClass = CellClass(row, port);
                                var cellLabel = CellLabel(row, port, cellClass);
                                <td class="@(!port.IsAvailable ? "port-unavailable" : "")"><button type="button" draggable="@(ReferencesPort(row.Route, port))" data-matrix-row="@r" data-matrix-column="@c" tabindex="@(matrixRow == r && matrixColumn == c ? 0 : -1)" class="matrix-cell @cellClass" disabled="@CellDisabled(row, port)" aria-label="@cellLabel" title="@cellLabel" @onclick="() => SelectCell(row, port)" @onkeydown="args => MatrixKeyDown(args, r, c)" @ondragstart="() => StartDrag(row)" @ondragover:preventDefault @ondrop="() => DropOn(row, port)"><span class="matrix-cell-mark" aria-hidden="true"></span>@if(ReferencesPort(row.Route, port) && row.Route?.Fps is not null){<span class="matrix-cell-detail">@row.Route.Fps.Value.ToString("0.00") fps</span>}</button></td>
                            }
                        </tr>
                    }
                    @if(matrixRows.Count == 0){<tr><td colspan="@(matrixPorts.Count + 1)"><div class="empty-state">No sources or saved routes match the current filter.</div></td></tr>}
                </tbody>
            </table>
        </div>
    </section>
    <RouteDetailPanel Snapshot="@snapshot" Presets="@presets" SelectedSourceId="@detailSourceId" SelectedPortId="@detailPortId" DraggedAssignment="@draggedAssignment" Refreshed="RefreshSnapshot" Closed="CloseDetail" />
</div>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }
    [SupplyParameterFromQuery(Name = "state")] public string? State { get; set; }
    private RouterSnapshot snapshot = null!;
    private IReadOnlyList<OutputPresetProfile> presets = [];
    private string error = "";
    private string confirmation = "";
    private bool pageBusy;
    private DateTimeOffset? emergencyUndoExpiresAt;
    private readonly HashSet<string> selectedRouteIds = new(StringComparer.Ordinal);
    private string? detailSourceId;
    private string? detailPortId;
    private string? draggedSourceId;
    private bool draggedAssignment;
    private string density = "comfortable";
    private int matrixRow;
    private int matrixColumn;
    private long settingsRevision = -1;
    private readonly SnapshotRenderCoalescer renderCoalescer = new();
    private IReadOnlyList<DeckLinkPort> matrixPorts = [];
    private IReadOnlyList<CardView> matrixCardGroups = [];
    private IReadOnlyList<CardView> outputCardGroups = [];
    private IReadOnlyList<MatrixRow> matrixRows = [];
    private IReadOnlyDictionary<string, RuntimeRoute> portOwners = new Dictionary<string, RuntimeRoute>(StringComparer.OrdinalIgnoreCase);
    private string StateFilter => string.IsNullOrWhiteSpace(State) ? "all" : State.ToLowerInvariant();
    private static readonly (string Value, string Label)[] RouteFilterOptions = [("all", "All"), ("running", "Running"), ("waiting", "Waiting"), ("failed", "Failed"), ("offline", "Offline"), ("unassigned", "Unassigned")];

    protected override void OnInitialized()
    {
        SetSnapshot(Coordinator.Snapshot);
        RefreshPresets();
        Coordinator.Changed += Changed;
    }

    protected override void OnParametersSet() => RebuildDerivedState();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var saved = await JS.InvokeAsync<string?>("broadcastRouter.getDensity");
        if (saved is "compact" or "comfortable") { density = saved; StateHasChanged(); }
    }

    private void Changed() => _ = renderCoalescer.DispatchAsync(action => InvokeAsync(action), () =>
    {
        SetSnapshot(Coordinator.Snapshot);
        if (settingsRevision != Coordinator.SettingsRevision) RefreshPresets();
        StateHasChanged();
    });

    private void RefreshPresets()
    {
        var settings = Coordinator.GetSettings();
        settingsRevision = settings.ConfigurationRevision;
        presets = settings.Presets;
    }

    private IOrderedEnumerable<DeckLinkPort> OrderedPorts() => snapshot.Ports
        .Where(port => port.IsOutputPort)
        .OrderBy(DeckLinkDisplayName.Card, StringComparer.OrdinalIgnoreCase)
        .ThenBy(DeckLinkDisplayName.Connector, StringComparer.OrdinalIgnoreCase);
    private void SetSnapshot(RouterSnapshot value)
    {
        snapshot = value;
        RebuildDerivedState();
    }

    private void RebuildDerivedState()
    {
        if (snapshot is null) return;

        matrixPorts = OrderedPorts().ToArray();
        matrixCardGroups = matrixPorts
            .GroupBy(port => port.DeviceGroupId ?? $"legacy-card-{port.CardIndex}", StringComparer.OrdinalIgnoreCase)
            .Select(group => new CardView(group.Key, group.ToArray()))
            .ToArray();
        outputCardGroups = snapshot.Ports
            .Where(port => port.IsOutputPort)
            .GroupBy(port => port.DeviceGroupId ?? $"legacy-card-{port.CardIndex}", StringComparer.OrdinalIgnoreCase)
            .Select(group => new CardView(group.Key, group.OrderBy(port => port.SubdeviceIndex).ToArray()))
            .OrderBy(card => DeckLinkDisplayName.Card(card.Ports[0]), StringComparer.OrdinalIgnoreCase)
            .ToArray();

        var sources = new Dictionary<string, DiscoveredSource>(StringComparer.Ordinal);
        foreach (var source in snapshot.Sources) sources.TryAdd(source.Identity.Value, source);
        var routes = new Dictionary<string, RuntimeRoute>(StringComparer.Ordinal);
        foreach (var route in snapshot.Routes) routes.TryAdd(route.SourceId, route);

        matrixRows = snapshot.Sources.Select(value => value.Identity.Value)
            .Concat(snapshot.Routes.Select(value => value.SourceId))
            .Distinct(StringComparer.Ordinal)
            .Select(id =>
            {
                sources.TryGetValue(id, out var source);
                routes.TryGetValue(id, out var route);
                return new MatrixRow(id, source?.FriendlyName ?? route?.SourceName ?? id, source, route);
            })
            .Where(row => string.IsNullOrWhiteSpace(Query)
                || row.Name.Contains(Query, StringComparison.OrdinalIgnoreCase)
                || row.Id.Contains(Query, StringComparison.OrdinalIgnoreCase))
            .Where(row => row.Route is not null
                ? MatchesState(row.Route)
                : StateFilter is "all" or "offline" or "unassigned")
            .OrderBy(row => row.Name, StringComparer.OrdinalIgnoreCase)
            .ToArray();
        portOwners = RoutePortOwnership.Map(matrixPorts, snapshot.Routes);
    }
    private bool MatchesState(RuntimeRoute route) => StateFilter switch { "running" => route.State == RouteState.Running, "waiting" => route.State == RouteState.WaitingForStream, "failed" => route.State == RouteState.Failed, "offline" => RouteStatus(route) == "Offline", "unassigned" => string.IsNullOrWhiteSpace(route.DesiredPortId ?? route.PortId), _ => true };
    private void UpdateQuery(ChangeEventArgs args) { Query = args.Value?.ToString(); RebuildDerivedState(); UpdateFilterAddress(); }
    private void SetStateFilter(string value) { State = value == "all" ? null : value; RebuildDerivedState(); UpdateFilterAddress(); }
    private void UpdateFilterAddress() => Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["q"] = string.IsNullOrWhiteSpace(Query) ? null : Query, ["state"] = State }), replace: true);
    private void ToggleRoute(string sourceId, object? value) { if(value is bool selected && selected) selectedRouteIds.Add(sourceId); else selectedRouteIds.Remove(sourceId); }
    private async Task BulkAction(string action)
    {
        var ids = selectedRouteIds.ToArray();
        if(ids.Length == 0 || pageBusy) return;
        var command = action == "release" ? "stop" : action;
        if(!await confirmDialog.ShowAsync($"{action} selected routes", $"This will {action} {ids.Length} selected routes. Other routes are not affected.", $"{char.ToUpperInvariant(action[0])}{action[1..]} {ids.Length}", action is "stop" or "release")) return;
        try { pageBusy = true; error = ""; foreach(var id in ids) await Commands.ExecuteAsync(command, id); selectedRouteIds.Clear(); confirmation = $"{ids.Length} routes received the {action} command."; }
        catch(Exception ex) { error = OperatorErrors.Describe(ex, $"the bulk {action} command"); }
        finally { pageBusy = false; }
    }

    private static bool ReferencesPort(RuntimeRoute? route, DeckLinkPort port) => route is not null
        && (route.PortId?.Equals(port.StableId, StringComparison.OrdinalIgnoreCase) == true
            || route.DesiredPortId?.Equals(port.StableId, StringComparison.OrdinalIgnoreCase) == true);
    private RuntimeRoute? PortOwner(DeckLinkPort port) => portOwners.GetValueOrDefault(port.StableId);
    private bool CellDisabled(MatrixRow row, DeckLinkPort port) => !port.IsAvailable || (PortOwner(port) is { } owner && owner.SourceId != row.Id);
    private string CellClass(MatrixRow row, DeckLinkPort port)
    {
        if (!port.IsAvailable) return "unavailable";
        var route = row.Route;
        if (!ReferencesPort(route, port)) return PortOwner(port) is null ? "free" : "occupied-other";
        if (route!.FailureCategory == "RoutingConflict") return "conflict";
        if (route.State == RouteState.Reconnecting) return "reconnecting";
        if (route.State == RouteState.Failed) return "failed";
        if (route.State == RouteState.WaitingForStream) return "waiting";
        if (route.State == RouteState.Running && route.PortId?.Equals(port.StableId, StringComparison.OrdinalIgnoreCase) == true) return "running";
        var sourceOffline = row.Source is null || row.Source.State is SourceState.PublisherDisconnected or SourceState.RtspUnavailable or SourceState.Disabled;
        if (route.Locked || (route.ReserveWhileOffline && sourceOffline)) return "reserved";
        return "desired";
    }
    private string CellLabel(MatrixRow row, DeckLinkPort port, string cellClass)
    {
        var state = cellClass switch
        {
            "occupied-other" => $"Occupied by {PortOwner(port)?.SourceName}",
            "free" => "Free; select to prepare assignment",
            "running" => $"Running, {row.Route?.Fps?.ToString("0.00") ?? "unknown"} fps",
            "reconnecting" => "Reconnecting",
            "failed" => $"Failed, {row.Route?.FailureCategory}",
            "waiting" => "Waiting for stream",
            "reserved" => "Reserved or locked",
            "desired" => "Desired but not active",
            "conflict" => "Routing conflict",
            _ => "Port unavailable"
        };
        return $"{row.Name} to {DeckLinkDisplayName.Full(port)}: {state}";
    }
    private void SelectCell(MatrixRow row, DeckLinkPort port) { detailSourceId = row.Id; detailPortId = port.StableId; draggedAssignment = false; }
    private void SelectSourceDetail(MatrixRow row) { detailSourceId = row.Id; detailPortId = null; draggedAssignment = false; }
    private void SelectPortDetail(DeckLinkPort port) { detailSourceId = null; detailPortId = port.StableId; draggedAssignment = false; }
    private void StartDrag(MatrixRow row) => draggedSourceId = row.Route is null ? null : row.Id;
    private void DropOn(MatrixRow row, DeckLinkPort port) { if(draggedSourceId != row.Id || CellDisabled(row, port)) return; detailSourceId = row.Id; detailPortId = port.StableId; draggedAssignment = !ReferencesPort(row.Route, port); draggedSourceId = null; }
    private Task RefreshSnapshot() { SetSnapshot(Coordinator.Snapshot); StateHasChanged(); return Task.CompletedTask; }
    private Task CloseDetail() { detailSourceId = null; detailPortId = null; draggedAssignment = false; return Task.CompletedTask; }
    private async Task ToggleDensity() { density = density == "compact" ? "comfortable" : "compact"; await JS.InvokeVoidAsync("broadcastRouter.setDensity", density); }
    private async Task MatrixKeyDown(KeyboardEventArgs args, int row, int column)
    {
        var rows = matrixRows.Count; var columns = matrixPorts.Count;
        if (rows == 0 || columns == 0) return;
        var nextRow = row; var nextColumn = column;
        switch(args.Key)
        {
            case "ArrowLeft": nextColumn = Math.Max(0, column - 1); break;
            case "ArrowRight": nextColumn = Math.Min(columns - 1, column + 1); break;
            case "ArrowUp": nextRow = Math.Max(0, row - 1); break;
            case "ArrowDown": nextRow = Math.Min(rows - 1, row + 1); break;
            case "Home": nextColumn = 0; break;
            case "End": nextColumn = columns - 1; break;
            case "Escape": await CloseDetail(); return;
            default: return;
        }
        matrixRow = nextRow; matrixColumn = nextColumn;
        await JS.InvokeVoidAsync("broadcastRouter.focusMatrixCell", nextRow, nextColumn);
    }

    private async Task Run(string action)
    {
        if (pageBusy) return;
        if (action == "emergency-stop" && !await confirmDialog.ShowAsync("Emergency stop", "Emergency stop will terminate every FFmpeg process owned by BroadcastRouter and release its routes.", "Stop all outputs")) return;
        try
        {
            pageBusy = true;
            error = ""; confirmation = "";
            await Commands.ExecuteAsync(action);
            SetSnapshot(Coordinator.Snapshot);
            if (action == "emergency-stop") emergencyUndoExpiresAt = DateTimeOffset.UtcNow.AddSeconds(30);
            if (action == "clear-emergency") emergencyUndoExpiresAt = null;
            if (action == "rescan") confirmation = "Reconciliation complete.";
        }
        catch (Exception ex) { error = OperatorErrors.Describe(ex, "the route command"); }
        finally { pageBusy = false; }
    }

    private async Task UndoEmergencyStop()
    {
        if (pageBusy || emergencyUndoExpiresAt is null || emergencyUndoExpiresAt <= DateTimeOffset.UtcNow) return;
        await Run("clear-emergency");
    }

    public void Dispose() => Coordinator.Changed -= Changed;
    private ConfirmDialog confirmDialog = null!;
    private string RouteStatus(RuntimeRoute route)
    {
        var source = snapshot.Sources.FirstOrDefault(value => value.Identity.Value == route.SourceId);
        if (route.FailureCategory == "RoutingConflict") return "Routing conflict";
        if (route.State == RouteState.WaitingForStream) return "Waiting for stream";
        if (source is null || source.State is SourceState.PublisherDisconnected or SourceState.RtspUnavailable or SourceState.Disabled) return "Offline";
        return route.State.ToString();
    }
    private sealed record CardView(string Key, IReadOnlyList<DeckLinkPort> Ports);
    private sealed record MatrixRow(string Id, string Name, DiscoveredSource? Source, RuntimeRoute? Route);
}
