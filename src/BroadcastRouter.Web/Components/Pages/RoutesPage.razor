@page "/routes"
@rendermode InteractiveServer
@using BroadcastRouter.Application
@inject RouterCoordinator Coordinator
@inject AuthorizedRouterCommands Commands
@inject DeckLinkAssetCatalog AssetCatalog
@inject OperatorErrorMessage OperatorErrors
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Routes · BroadcastRouter</PageTitle>
<ConfirmDialog @ref="confirmDialog" />
<div class="page-head">
    <div><h1>Routes / Routing Matrix</h1><p class="lead">Every route acquires one atomic port lease before FFmpeg is allowed to start.</p></div>
    <AuthorizeView Roles="Administrator"><Authorized><div class="actions"><button class="btn" disabled="@pageBusy" @onclick='() => Run("rescan", "")'>@(pageBusy ? "Reconciling…" : "Reconcile now")</button><button class="btn danger" disabled="@pageBusy" @onclick='() => Run("emergency-stop", "")'>@(pageBusy ? "Stopping…" : "Emergency stop")</button></div></Authorized></AuthorizeView>
</div>
<NoticeBoard Severity="danger" @bind-Message="error" />
<NoticeBoard Severity="success" @bind-Message="confirmation" />
<div class="filter-bar" role="search">
    <label class="filter-search"><span>Filter routes</span><input data-operator-filter aria-label="Filter routes by source name or ID" value="@Query" @oninput="UpdateQuery" placeholder="Name or source ID" /></label>
    <div class="filter-chips" aria-label="Filter routes by state">@foreach(var option in RouteFilterOptions){<button type="button" class="filter-chip @(StateFilter == option.Value ? "active" : "")" aria-pressed="@(StateFilter == option.Value)" @onclick="() => SetStateFilter(option.Value)">@option.Label</button>}</div>
    <AuthorizeView Roles="Administrator"><Authorized><div class="bulk-actions" aria-label="Selected route actions"><span>@selectedRouteIds.Count selected</span><button class="btn small" disabled="@(selectedRouteIds.Count == 0 || pageBusy)" @onclick='() => BulkAction("restart")'>Restart</button><button class="btn small" disabled="@(selectedRouteIds.Count == 0 || pageBusy)" @onclick='() => BulkAction("stop")'>Stop</button><button class="btn small danger" disabled="@(selectedRouteIds.Count == 0 || pageBusy)" @onclick='() => BulkAction("release")'>Release</button></div></Authorized></AuthorizeView>
</div>

@if (OutputCardGroups().Count > 0)
{
    <details class="panel route-hardware-guide">
        <summary><span><strong>Physical output guide</strong><small>Match software outputs to the installed card and connector before changing a route.</small></span><span class="badge @(AssetCatalog.Status.Installed ? "success" : "neutral")">@(AssetCatalog.Status.Installed ? "Visual pack loaded" : "Technical view")</span></summary>
        <div class="panel-body route-hardware-grid">
        @foreach (var card in OutputCardGroups())
        {
            <div class="route-hardware-card" @key="card.Key"><h3>@DeckLinkDisplayName.Card(card.Ports[0])</h3><BroadcastRouter.Web.Components.Shared.DeckLinkCardVisual CardKey="@card.Key" Ports="@card.Ports" Routes="@snapshot.Routes" Compact="true" ShowTechnicalImages="false" /></div>
        }
        </div>
    </details>
}

<div class="route-list">
@foreach (var route in FilteredRoutes)
{
    <article class="route-editor" @key="route.SourceId">
        <header class="route-editor-head">
            <div class="route-title"><AuthorizeView Roles="Administrator"><Authorized><input type="checkbox" aria-label="Select route @route.SourceName" checked="@selectedRouteIds.Contains(route.SourceId)" @onchange="args => ToggleRoute(route.SourceId, args.Value)" /></Authorized></AuthorizeView><span><strong>@route.SourceName</strong><span class="secondary-text mono">@route.SourceId</span></span></div>
            <div class="route-state"><BroadcastRouter.Web.Components.Shared.StateBadge Value="RouteStatus(route)" /><span class="badge @AssignmentBadgeClass(route)">@AssignmentStatus(route)</span>@if (route.Locked) { <span class="badge warning">reserved</span> }</div>
        </header>
        <div class="route-summary-grid">
            <div><span class="field-label">Priority</span><strong>@route.Priority</strong></div>
            <div><span class="field-label">Assignment</span><strong>@route.AssignmentMode</strong></div>
            <div><span class="field-label">Health</span><strong>@(route.Fps?.ToString("0.00") ?? "—") fps</strong><span class="secondary-text">drop @route.DroppedFrames · dup @route.DuplicatedFrames · retry @route.RestartCount</span></div>
            <AuthorizeView Roles="Administrator">
                <Authorized>
                    <div class="route-assignment-fields">
                        <div class="form-group"><label>DeckLink output</label><select aria-label="Output for @route.SourceName" disabled="@IsBusy(route.SourceId)" value="@SelectedPort(route)" @onchange="eventArgs => SelectPort(route.SourceId, eventArgs.Value?.ToString())"><option value="">Automatic / unassigned</option>@if(IsUnavailableOutput(SelectedPort(route))){<option value="@SelectedPort(route)">Saved output unavailable or excluded (@DeckLinkDisplayName.ShortIdentity(SelectedPort(route)))</option>}@foreach (var port in OrderedPorts()) { <option value="@port.StableId">@DeckLinkDisplayName.Full(port)</option> }</select></div>
                        <div class="form-group"><label>Output preset</label><select aria-label="Preset for @route.SourceName" disabled="@IsBusy(route.SourceId)" value="@SelectedPreset(route)" @onchange="eventArgs => SelectPreset(route.SourceId, eventArgs.Value?.ToString())">@foreach (var preset in presets) { <option value="@preset.Id">@preset.Name</option> }</select></div>
                        <div class="form-group"><label>Saved routing priority</label><select aria-label="Assignment type for @route.SourceName" value="@SelectedMode(route)" @onchange="eventArgs => SelectMode(route.SourceId, eventArgs.Value?.ToString())"><option value="@AssignmentMode.Preconfigured">Preconfigured (highest)</option><option value="@AssignmentMode.Manual">Manual</option></select></div>
                        <div class="form-group route-apply"><label>Assignment change</label><button class="btn primary" disabled="@(IsBusy(route.SourceId) || presets.Count == 0 || string.IsNullOrWhiteSpace(SelectedPort(route)))" @onclick="() => ApplyAssignment(route)">@(IsBusy(route.SourceId) ? "Saving…" : "Save assignment")</button></div>
                    </div>
                    <div class="route-policy-options"><label class="check"><input type="checkbox" checked="@ReserveOffline(route)" @onchange="eventArgs => SetReserveOffline(route.SourceId, eventArgs.Value)" />Reserve output while stream is offline</label><label class="check"><input type="checkbox" checked="@AllowTemporary(route)" @onchange="eventArgs => SetAllowTemporary(route.SourceId, eventArgs.Value)" />Allow automatic streams to use it temporarily</label></div>
                </Authorized>
                <NotAuthorized>
                    <div><span class="field-label">DeckLink output</span><strong>@RoutePortName(route)</strong><span class="secondary-text">Preset @route.PresetId</span></div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
        @if (route.HoldOutputWhilePublisherLive)
        {
            <div class="notice warning" role="status">Hold while Wowza live is ON. Frozen picture, silence, input errors, and media-mode changes will not trigger a restart while the owned live process is running and Wowza last confirmed live. API outages retain that confirmation. Publisher stop, process exit, and manual commands still take effect.</div>
        }
        <AuthorizeView Roles="Administrator"><Authorized>
            @if (route.HoldOutputWhilePublisherLive || IsWowzaSource(route))
            {
                <div class="route-controls">
                    <button class="btn small @(route.HoldOutputWhilePublisherLive ? "warning" : "")" disabled="@IsBusy(route.SourceId)"
                            aria-pressed="@route.HoldOutputWhilePublisherLive.ToString().ToLowerInvariant()"
                            @onclick='() => Run(route.HoldOutputWhilePublisherLive ? "disable-live-hold" : "enable-live-hold", route.SourceId)'>Hold while Wowza live: @(route.HoldOutputWhilePublisherLive ? "On" : "Off")</button>
                    <span class="secondary-text">Saved immediately per stream. Manual restart and crash recovery remain available.</span>
                </div>
            }
        </Authorized></AuthorizeView>
        <AuthorizeView Roles="Administrator"><Authorized><footer class="route-controls"><button class="btn small primary" disabled="@IsBusy(route.SourceId)" @onclick='() => Run("restore", route.SourceId)'>@(IsBusy(route.SourceId) ? "Working…" : "Activate / restore")</button><button class="btn small" disabled="@IsBusy(route.SourceId)" @onclick='() => Run("restart", route.SourceId)'>Restart live output</button><button class="btn small danger" disabled="@(IsBusy(route.SourceId) || !DesiredRoutePolicy.HasSavedAssignment(route))" title="@(DesiredRoutePolicy.HasSavedAssignment(route) ? "Remove the saved assignment" : "This route has no saved assignment")" @onclick='() => Run("remove-assignment", route.SourceId)'>Remove saved assignment</button><button class="btn small danger" disabled="@(IsBusy(route.SourceId) || DesiredRoutePolicy.HasSavedAssignment(route))" title="@(!DesiredRoutePolicy.HasSavedAssignment(route) ? "Release the automatic route" : "Saved assignments must be removed instead")" @onclick='() => Run("stop", route.SourceId)'>Release automatic route</button></footer></Authorized></AuthorizeView>
        @if (snapshot.SimulationMode) { <AuthorizeView Roles="Administrator"><Authorized><footer class="route-controls simulation-controls"><span class="secondary-text">Simulation:</span><button class="btn small" disabled="@IsBusy(route.SourceId)" @onclick='() => Run("simulate-failure", route.SourceId)'>Crash</button><button class="btn small" disabled="@IsBusy(route.SourceId)" @onclick='() => Run("simulate-stall", route.SourceId)'>Stall</button><button class="btn small" disabled="@IsBusy(route.SourceId)" @onclick='() => Run("clear-failure", route.SourceId)'>Recover</button></footer></Authorized></AuthorizeView> }
    </article>
}
@if (FilteredRoutes.Count == 0) { <div class="panel"><div class="empty-state">@(snapshot.Routes.Count == 0 ? "No desired routes are currently configured." : "No routes match the current filter.")</div></div> }
</div>

<AuthorizeView Roles="Administrator"><Authorized>
    <div class="panel"><div class="panel-head"><div><h2>Prepare a routing entry</h2><span class="secondary-text">Offline streams are accepted. The entry activates automatically as soon as the stream becomes ready.</span></div></div><div class="panel-body"><div class="manual-route-grid">
        <div class="form-group"><label>Source</label><select aria-label="Manual route source" @bind="selectedSource"><option value="">Select source…</option>@foreach (var source in snapshot.Sources) { <option value="@source.Identity.Value">@source.FriendlyName</option> }</select></div>
        <div class="form-group"><label>Output port</label><select aria-label="Manual route output" @bind="selectedPort"><option value="">Select an output…</option>@foreach (var port in OrderedPorts()) { <option value="@port.StableId">@DeckLinkDisplayName.Full(port)</option> }</select></div>
        <div class="form-group"><label>Output preset</label><select aria-label="Manual route preset" @bind="selectedPreset">@foreach (var preset in presets) { <option value="@preset.Id">@preset.Name</option> }</select></div>
        <div class="form-group"><label>Routing priority</label><select aria-label="New route assignment type" @bind="selectedMode"><option value="@AssignmentMode.Preconfigured">Preconfigured (highest)</option><option value="@AssignmentMode.Manual">Manual</option></select></div>
        <div class="form-group route-apply"><label>Routing entry</label><button class="btn primary" disabled="@(pageBusy || string.IsNullOrWhiteSpace(selectedSource) || string.IsNullOrWhiteSpace(selectedPort) || string.IsNullOrWhiteSpace(selectedPreset))" @onclick="CreateRoute">@(pageBusy ? "Saving…" : "Save routing entry")</button></div>
    </div></div></div>
</Authorized></AuthorizeView>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }
    [SupplyParameterFromQuery(Name = "state")] public string? State { get; set; }
    private RouterSnapshot snapshot = null!;
    private IReadOnlyList<OutputPresetProfile> presets = [];
    private readonly Dictionary<string, string> selectedPorts = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> selectedPresets = new(StringComparer.Ordinal);
    private readonly Dictionary<string, AssignmentMode> selectedModes = new(StringComparer.Ordinal);
    private readonly Dictionary<string, bool> reserveOffline = new(StringComparer.Ordinal);
    private readonly Dictionary<string, bool> allowTemporary = new(StringComparer.Ordinal);
    private string selectedSource = "";
    private string selectedPort = "";
    private string selectedPreset = "";
    private AssignmentMode selectedMode = AssignmentMode.Manual;
    private string error = "";
    private string confirmation = "";
    private bool pageBusy;
    private readonly HashSet<string> busySourceIds = new(StringComparer.Ordinal);
    private readonly HashSet<string> selectedRouteIds = new(StringComparer.Ordinal);
    private long settingsRevision = -1;
    private string StateFilter => string.IsNullOrWhiteSpace(State) ? "all" : State.ToLowerInvariant();
    private static readonly (string Value, string Label)[] RouteFilterOptions = [("all", "All"), ("running", "Running"), ("waiting", "Waiting"), ("failed", "Failed"), ("offline", "Offline"), ("unassigned", "Unassigned")];
    private IReadOnlyList<RuntimeRoute> FilteredRoutes => snapshot.Routes.Where(route => string.IsNullOrWhiteSpace(Query) || route.SourceName.Contains(Query, StringComparison.OrdinalIgnoreCase) || route.SourceId.Contains(Query, StringComparison.OrdinalIgnoreCase)).Where(MatchesState).OrderBy(route => route.SourceName, StringComparer.OrdinalIgnoreCase).ToArray();

    protected override void OnInitialized()
    {
        snapshot = Coordinator.Snapshot;
        RefreshPresets();
        Coordinator.Changed += Changed;
    }

    private void Changed() => _ = InvokeAsync(() => { snapshot = Coordinator.Snapshot; if (settingsRevision != Coordinator.SettingsRevision) RefreshPresets(); StateHasChanged(); });

    private void RefreshPresets()
    {
        var settings = Coordinator.GetSettings();
        settingsRevision = settings.ConfigurationRevision;
        presets = settings.Presets;
        if (presets.Count > 0 && !presets.Any(preset => preset.Id.Equals(selectedPreset, StringComparison.OrdinalIgnoreCase))) selectedPreset = presets[0].Id;
    }

    private string SelectedPort(RuntimeRoute route) => selectedPorts.TryGetValue(route.SourceId, out var value) ? value : route.DesiredPortId ?? route.PortId ?? "";
    private string SelectedPreset(RuntimeRoute route) => selectedPresets.TryGetValue(route.SourceId, out var value) ? value : route.PresetId;
    private AssignmentMode SelectedMode(RuntimeRoute route) => selectedModes.TryGetValue(route.SourceId, out var value) ? value : route.AssignmentMode == AssignmentMode.Preconfigured ? AssignmentMode.Preconfigured : AssignmentMode.Manual;
    private bool ReserveOffline(RuntimeRoute route) => reserveOffline.TryGetValue(route.SourceId, out var value) ? value : route.ReserveWhileOffline;
    private bool AllowTemporary(RuntimeRoute route) => allowTemporary.TryGetValue(route.SourceId, out var value) ? value : route.AllowTemporaryUse;
    private string RoutePortName(RuntimeRoute route) => (route.DesiredPortId ?? route.PortId) is { Length: > 0 } portId
        && snapshot.Ports.FirstOrDefault(port => port.StableId.Equals(portId, StringComparison.OrdinalIgnoreCase)) is { } port
        ? DeckLinkDisplayName.Full(port) : route.PortName ?? "Unassigned";
    private void SelectPort(string sourceId, string? value) => selectedPorts[sourceId] = value?.Trim() ?? "";
    private void SelectPreset(string sourceId, string? value) => selectedPresets[sourceId] = value?.Trim() ?? "";
    private void SelectMode(string sourceId, string? value) => selectedModes[sourceId] = Enum.TryParse<AssignmentMode>(value, out var mode) ? mode : AssignmentMode.Manual;
    private void SetReserveOffline(string sourceId, object? value) => reserveOffline[sourceId] = value is bool selected && selected;
    private void SetAllowTemporary(string sourceId, object? value) => allowTemporary[sourceId] = value is bool selected && selected;
    private IOrderedEnumerable<DeckLinkPort> OrderedPorts() => snapshot.Ports
        .Where(port => port.IsOutputPort)
        .OrderBy(DeckLinkDisplayName.Card, StringComparer.OrdinalIgnoreCase)
        .ThenBy(DeckLinkDisplayName.Connector, StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<CardView> OutputCardGroups() => snapshot.Ports
        .GroupBy(port => port.DeviceGroupId ?? $"legacy-card-{port.CardIndex}", StringComparer.OrdinalIgnoreCase)
        .Where(group => group.Any(port => port.IsOutputPort))
        .Select(group => new CardView(group.Key, group.OrderBy(port => port.SubdeviceIndex).ToArray()))
        .OrderBy(card => DeckLinkDisplayName.Card(card.Ports[0]), StringComparer.OrdinalIgnoreCase)
        .ToArray();
    private bool IsUnavailableOutput(string stableId) => !string.IsNullOrWhiteSpace(stableId)
        && !snapshot.Ports.Any(port => port.IsOutputPort && port.StableId.Equals(stableId, StringComparison.OrdinalIgnoreCase));
    private bool MatchesState(RuntimeRoute route) => StateFilter switch { "running" => route.State == RouteState.Running, "waiting" => route.State == RouteState.WaitingForStream, "failed" => route.State == RouteState.Failed, "offline" => RouteStatus(route) == "Offline", "unassigned" => string.IsNullOrWhiteSpace(route.DesiredPortId ?? route.PortId), _ => true };
    private void UpdateQuery(ChangeEventArgs args) { Query = args.Value?.ToString(); UpdateFilterAddress(); }
    private void SetStateFilter(string value) { State = value == "all" ? null : value; UpdateFilterAddress(); }
    private void UpdateFilterAddress() => Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["q"] = string.IsNullOrWhiteSpace(Query) ? null : Query, ["state"] = State }), replace: true);
    private void ToggleRoute(string sourceId, object? value) { if(value is bool selected && selected) selectedRouteIds.Add(sourceId); else selectedRouteIds.Remove(sourceId); }
    private async Task BulkAction(string action)
    {
        var ids = selectedRouteIds.ToArray();
        if(ids.Length == 0 || pageBusy) return;
        var command = action == "release" ? "stop" : action;
        if(!await confirmDialog.ShowAsync($"{action} selected routes", $"This will {action} {ids.Length} selected routes. Other routes are not affected.", $"{char.ToUpperInvariant(action[0])}{action[1..]} {ids.Length}", action is "stop" or "release")) return;
        try { pageBusy = true; error = ""; foreach(var id in ids) await Commands.ExecuteAsync(command, id); selectedRouteIds.Clear(); confirmation = $"{ids.Length} routes received the {action} command."; }
        catch(Exception ex) { error = OperatorErrors.Describe(ex, $"the bulk {action} command"); }
        finally { pageBusy = false; }
    }

    private async Task Run(string action, string source)
    {
        var isPageCommand = string.IsNullOrWhiteSpace(source);
        if (isPageCommand ? pageBusy : IsBusy(source)) return;
        if (action == "emergency-stop" && !await confirmDialog.ShowAsync("Emergency stop", "Emergency stop will terminate every FFmpeg process owned by BroadcastRouter and release its routes.", "Stop all outputs")) return;
        var route = snapshot.Routes.FirstOrDefault(x => x.SourceId == source);
        if (action == "enable-live-hold" && !await confirmDialog.ShowAsync("Disable media recovery", "A frozen picture or muted audio may persist until you manually restart while Wowza last reports live. Publisher-stop and process-exit recovery remain enabled.", "Disable recovery")) return;
        if (action == "remove-assignment" && !await confirmDialog.ShowAsync("Remove saved assignment", "This removes the saved routing entry and releases its output for other streams.", "Remove assignment")) return;
        try
        {
            if (isPageCommand) pageBusy = true; else busySourceIds.Add(source);
            error = ""; confirmation = "";
            await Commands.ExecuteAsync(action, string.IsNullOrWhiteSpace(source) ? null : source);
            snapshot = Coordinator.Snapshot;
            if (action is "enable-live-hold" or "disable-live-hold")
                confirmation = $"Recovery setting saved and applied successfully at {DateTimeOffset.Now:yyyy-MM-dd HH:mm:ss zzz}.";
        }
        catch (Exception ex) { error = OperatorErrors.Describe(ex, "the route command"); }
        finally { if (isPageCommand) pageBusy = false; else busySourceIds.Remove(source); }
    }

    private async Task ApplyAssignment(RuntimeRoute route)
    {
        if (IsBusy(route.SourceId)) return;
        var port = SelectedPort(route);
        var preset = SelectedPreset(route);
        try
        {
            busySourceIds.Add(route.SourceId);
            error = "";
            await Commands.ExecuteAsync("save-assignment", route.SourceId, port, preset, SelectedMode(route),
                ReserveOffline(route), AllowTemporary(route));
            selectedPorts.Remove(route.SourceId);
            selectedPresets.Remove(route.SourceId);
        }
        catch (Exception ex) { error = OperatorErrors.Describe(ex, "saving the route assignment"); }
        finally { busySourceIds.Remove(route.SourceId); }
    }

    private async Task CreateRoute()
    {
        if (pageBusy) return;
        try { pageBusy = true; error = ""; await Commands.ExecuteAsync("save-assignment", selectedSource, selectedPort, selectedPreset,
            selectedMode, reserveWhileOffline: true, allowTemporaryUse: false); }
        catch (Exception ex) { error = OperatorErrors.Describe(ex, "creating the route"); }
        finally { pageBusy = false; }
    }

    public void Dispose() => Coordinator.Changed -= Changed;
    private ConfirmDialog confirmDialog = null!;
    private bool IsBusy(string sourceId) => pageBusy || busySourceIds.Contains(sourceId);
    private bool IsWowzaSource(RuntimeRoute route) => snapshot.Sources.Any(source =>
        source.Identity.Value == route.SourceId && !source.Identity.ServerId.Equals("MANUAL", StringComparison.OrdinalIgnoreCase));
    private string RouteStatus(RuntimeRoute route)
    {
        var source = snapshot.Sources.FirstOrDefault(value => value.Identity.Value == route.SourceId);
        if (route.FailureCategory == "RoutingConflict") return "Routing conflict";
        if (route.State == RouteState.WaitingForStream) return "Waiting for stream";
        if (source is null || source.State is SourceState.PublisherDisconnected or SourceState.RtspUnavailable or SourceState.Disabled) return "Offline";
        return route.State.ToString();
    }
    private static string AssignmentStatus(RuntimeRoute route) => route.AssignmentMode switch
    {
        AssignmentMode.Preconfigured or AssignmentMode.Fixed or AssignmentMode.Rule => "Preconfigured",
        AssignmentMode.Manual => "Manually assigned",
        AssignmentMode.Automatic => "Automatically assigned",
        _ => "Unassigned"
    };
    private static string AssignmentBadgeClass(RuntimeRoute route) => route switch
    {
        { FailureCategory: "RoutingConflict" } => "danger",
        { AssignmentMode: AssignmentMode.Preconfigured or AssignmentMode.Fixed or AssignmentMode.Rule } => "preconfigured",
        { AssignmentMode: AssignmentMode.Manual } => "manual",
        { AssignmentMode: AssignmentMode.Automatic } => "automatic",
        _ => "unassigned"
    };
    private sealed record CardView(string Key, IReadOnlyList<DeckLinkPort> Ports);
}
