@page "/routes"
@rendermode InteractiveServer
@inject RouterCoordinator Coordinator
@inject AuthorizedRouterCommands Commands
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Routes · BroadcastRouter</PageTitle>
<div class="page-head"><div><h1>Routes / Routing Matrix</h1><p class="lead">Every route acquires one atomic port lease before FFmpeg is allowed to start.</p></div><AuthorizeView Roles="Administrator"><Authorized><div class="actions"><button class="btn" disabled="@busy" @onclick='() => Run("rescan", "")'>Reconcile now</button><button class="btn danger" disabled="@busy" @onclick='() => Run("emergency-stop", "")'>Emergency stop</button></div></Authorized></AuthorizeView></div>
@if (!string.IsNullOrWhiteSpace(error)) { <div class="notice danger" role="alert">@error</div> }
<div class="panel"><div class="table-wrap"><table><thead><tr><th>Priority</th><th>Source</th><th></th><th>DeckLink output</th><th>Assignment</th><th>State</th><th>Health</th><th>Controls</th></tr></thead><tbody>
@foreach (var route in snapshot.Routes)
{
    <tr><td>@route.Priority</td><td><span class="primary-text">@route.SourceName</span><span class="secondary-text">@route.SourceId</span></td><td style="font-size:22px;color:var(--accent)">→</td>
        <td><AuthorizeView Roles="Administrator"><Authorized><select aria-label="Output for @route.SourceName" disabled="@busy" value="@(route.PortId ?? "")" @onchange="e => Reassign(route.SourceId, e.Value?.ToString())"><option value="">Automatic / unassigned</option>@foreach(var port in snapshot.Ports){<option value="@port.StableId">@(port.FriendlyName ?? port.FfmpegName)</option>}</select></Authorized><NotAuthorized><span class="primary-text">@(route.PortName ?? "Unassigned")</span></NotAuthorized></AuthorizeView><span class="secondary-text">Preset @route.PresetId</span></td>
        <td>@route.AssignmentMode @if(route.Locked){<span class="badge warning">locked</span>}</td><td><BroadcastRouter.Web.Components.Shared.StateBadge Value="route.State" /></td>
        <td>@(route.Fps?.ToString("0.00") ?? "—") fps<span class="secondary-text">drop @route.DroppedFrames · dup @route.DuplicatedFrames · retry @route.RestartCount</span></td>
        <td><AuthorizeView Roles="Administrator"><Authorized><div class="actions"><button class="btn small primary" @onclick='() => Run("restore", route.SourceId)'>Restore</button><button class="btn small" @onclick='() => Run("restart", route.SourceId)'>Restart</button><button class="btn small" @onclick='() => Run(route.Locked ? "unlock" : "lock", route.SourceId)'>@(route.Locked ? "Unlock" : "Lock")</button><button class="btn small warning" @onclick='() => Run("standby", route.SourceId)'>Standby</button><button class="btn small danger" @onclick='() => Run("stop", route.SourceId)'>Stop</button></div></Authorized></AuthorizeView></td></tr>
    @if (snapshot.SimulationMode) { <AuthorizeView Roles="Administrator"><Authorized><tr><td></td><td colspan="7"><div class="actions"><span class="secondary-text">Simulation:</span><button class="btn small" @onclick='() => Run("simulate-failure", route.SourceId)'>Crash</button><button class="btn small" @onclick='() => Run("simulate-stall", route.SourceId)'>Stall</button><button class="btn small" @onclick='() => Run("clear-failure", route.SourceId)'>Recover</button></div></td></tr></Authorized></AuthorizeView> }
}
</tbody></table></div></div>

<AuthorizeView Roles="Administrator"><Authorized><div class="panel"><div class="panel-head"><h2>Create manual route</h2></div><div class="panel-body"><div class="form-grid"><div class="form-group"><label>Source</label><select aria-label="Manual route source" @bind="selectedSource"><option value="">Select source…</option>@foreach(var source in snapshot.Sources){<option value="@source.Identity.Value">@source.FriendlyName</option>}</select></div><div class="form-group"><label>Output</label><select aria-label="Manual route output" @bind="selectedPort"><option value="">Automatic</option>@foreach(var port in snapshot.Ports){<option value="@port.StableId">@(port.FriendlyName ?? port.FfmpegName)</option>}</select></div><div class="form-group"><label>&nbsp;</label><button class="btn primary" disabled="@(busy || string.IsNullOrWhiteSpace(selectedSource))" @onclick="CreateRoute">Start route</button></div></div></div></div></Authorized></AuthorizeView>

@code {
    private RouterSnapshot snapshot = null!; private string selectedSource = ""; private string selectedPort = ""; private string error = ""; private bool busy;
    protected override void OnInitialized() { snapshot = Coordinator.Snapshot; Coordinator.Changed += Changed; }
    private void Changed() => _ = InvokeAsync(() => { snapshot = Coordinator.Snapshot; StateHasChanged(); });
    private async Task Run(string action, string source) { if (busy) return; if (action == "emergency-stop" && !await JS.InvokeAsync<bool>("confirm", "Emergency stop will terminate every FFmpeg process owned by BroadcastRouter and release its routes. Continue?")) return; var route = snapshot.Routes.FirstOrDefault(x => x.SourceId == source); if (action == "stop" && route?.Locked == true) { error = "This route is locked. Unlock it first, or use the confirmed emergency stop for a forced release."; return; } try { busy = true; error = ""; await Commands.ExecuteAsync(action, string.IsNullOrWhiteSpace(source) ? null : source); } catch(Exception ex) { error = ex.Message; } finally { busy = false; } }
    private async Task Reassign(string source, string? port) { if (busy || !await JS.InvokeAsync<bool>("confirm", "Reassigning this route stops its current output before reserving the selected output. Continue?")) return; try { busy = true; error = ""; await Commands.ExecuteAsync("reassign", source, string.IsNullOrWhiteSpace(port) ? null : port); } catch(Exception ex) { error = ex.Message; } finally { busy = false; } }
    private async Task CreateRoute() { if (busy) return; try { busy = true; error = ""; await Commands.ExecuteAsync("start", selectedSource, string.IsNullOrWhiteSpace(selectedPort) ? null : selectedPort); } catch(Exception ex) { error = ex.Message; } finally { busy = false; } }
    public void Dispose() => Coordinator.Changed -= Changed;
}
