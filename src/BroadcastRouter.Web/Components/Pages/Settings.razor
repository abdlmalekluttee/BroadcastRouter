@page "/settings"
@attribute [Authorize(Roles = "Administrator")]
@rendermode InteractiveServer
@implements IDisposable
@inject RouterCoordinator Coordinator
@inject AuthorizedRouterCommands Commands
@inject IJSRuntime JS

<PageTitle>Settings · BroadcastRouter</PageTitle>
<div class="page-head"><div><h1>Settings</h1><p class="lead">Persistent SQLite configuration, DPAPI credentials, media-tool validation, routing policy, and manual inputs.</p></div><button class="btn primary" disabled="@saving" @onclick="Save">@(saving ? "Saving…" : "Save settings")</button></div>
@if (!string.IsNullOrWhiteSpace(message)) { <div class="notice @messageClass" role="status">@message</div> }

<div class="panel"><div class="panel-head"><h2>Operating mode</h2></div><div class="panel-body"><label class="check"><InputCheckbox aria-label="Simulation mode" @bind-Value="settings.SimulationMode" /><strong>Simulation mode</strong></label><p class="secondary-text">Turn simulation off only after selecting and validating production media tools. Changing hosting address or authentication requires an application restart.</p></div></div>

<div class="panel"><div class="panel-head"><h2>Media Tools</h2><div class="actions"><BroadcastRouter.Web.Components.Shared.StateBadge Value="Coordinator.Snapshot.ToolValidation.State" /><button class="btn small" @onclick="Validate">Validate / rescan</button></div></div><div class="panel-body">
    <div class="form-grid"><div class="form-group wide"><label>ffmpeg.exe</label><InputText aria-label="FFmpeg executable path" @bind-Value="settings.MediaTools.FfmpegPath" placeholder="C:\MediaTools\ffmpeg.exe" /></div><div class="form-group wide"><label>ffprobe.exe</label><InputText aria-label="FFprobe executable path" @bind-Value="settings.MediaTools.FfprobePath" placeholder="C:\MediaTools\ffprobe.exe" /></div></div>
    <ul class="validation-list" style="margin-top:15px">@foreach(var finding in Coordinator.Snapshot.ToolValidation.Findings){<li class="@(finding.StartsWith("PASS") ? "pass" : finding.StartsWith("FAIL") ? "fail" : "warn")">@finding</li>}</ul>
</div></div>

<div class="panel"><div class="panel-head"><h2>Routing and recovery</h2></div><div class="panel-body"><div class="form-grid">
    <div class="form-group check"><InputCheckbox aria-label="Automatic routing enabled" @bind-Value="settings.Routing.AutomaticRoutingEnabled" /><label>Automatic routing enabled</label></div><div class="form-group"><label>Reservation grace (seconds)</label><InputNumber aria-label="Reservation grace seconds" @bind-Value="settings.Routing.ReservationGraceSeconds" /></div><div class="form-group"><label>Primary stable before restore (seconds)</label><InputNumber aria-label="Primary stable seconds" @bind-Value="settings.Routing.StableRestoreSeconds" /></div><div class="form-group"><label>First progress timeout (seconds)</label><InputNumber aria-label="First progress timeout seconds" @bind-Value="settings.Routing.FirstProgressTimeoutSeconds" /></div><div class="form-group"><label>Stall timeout (seconds)</label><InputNumber aria-label="Stall timeout seconds" @bind-Value="settings.Routing.StallTimeoutSeconds" /></div><div class="form-group"><label>Graceful stop timeout (seconds)</label><InputNumber aria-label="Graceful stop timeout seconds" @bind-Value="settings.Routing.GracefulStopSeconds" /></div><div class="form-group"><label>Maximum retry attempts</label><InputNumber aria-label="Maximum retry attempts" @bind-Value="settings.Routing.MaxRetryAttempts" /><span class="secondary-text">0 keeps retrying indefinitely; a positive cap releases unlocked outputs after exhaustion.</span></div><div class="form-group"><label>Retry delays</label><input aria-label="Retry delays in seconds" value="@retryDelays" @oninput="e => retryDelays = e.Value?.ToString() ?? retryDelays" /><span class="secondary-text">Comma-separated seconds, e.g. 1,2,5,10,20,30</span></div>
</div></div></div>

<div class="panel"><div class="panel-head"><div><h2>Physical DeckLink cards</h2><span class="secondary-text">Give each persistent physical card a name that operators recognize. The name follows the card if identical models swap PCIe slots.</span></div></div><div class="panel-body decklink-card-settings">
@foreach (var card in PersistentCardGroups())
{
    var mapping = CardOverride(card.Key, card.Ports[0]);
    <div class="card decklink-card-setting" @key="card.Key"><div><span class="stat-label">@card.Ports[0].ModelName · @card.Ports.Count connector(s)</span><strong>@(string.IsNullOrWhiteSpace(mapping.FriendlyName) ? "Unnamed physical card" : mapping.FriendlyName)</strong><span class="secondary-text">Hardware identity @DeckLinkDisplayName.ShortIdentity(card.Key)</span></div><div class="form-group"><label>Card name</label><input aria-label="@($"Card name for {DeckLinkDisplayName.ShortIdentity(card.Key)}")" @bind="mapping.FriendlyName" @bind:event="oninput" placeholder="e.g. Studio input card" /></div></div>
}
@if (!PersistentCardGroups().Any()) { <div class="empty-state compact">No persistent physical-card identities are available. Validate and rescan the DeckLink hardware first.</div> }
</div></div>

<div class="panel"><div class="panel-head"><div><h2>DeckLink connector mappings and standby</h2><span class="secondary-text">Only connectors marked as output ports can be used by saved, manual, or automatic routing. Each output can keep its own broadcast standby screen on air.</span></div></div><div class="panel-body port-config-list">
@foreach(var port in Coordinator.Snapshot.Ports)
{
    var mapping = PortOverride(port);
    <article class="port-config-card" @key="port.StableId">
        <div class="port-config-title"><div><span class="stat-label">@PendingCardName(port) · connector @(port.SubdeviceIndex + 1)</span><h3>@DeckLinkDisplayName.Connector(port)</h3><span class="secondary-text mono">Identity @DeckLinkDisplayName.ShortIdentity(port.StableId)</span></div><label class="check output-port-toggle"><InputCheckbox aria-label="@($"Mark {port.FfmpegName} as an output port")" @bind-Value="mapping.IsOutputPort" /><strong>Output port</strong></label></div>
        <div class="form-grid compact">
            <div class="form-group"><label>Connector name</label><InputText aria-label="@($"Connector name for {port.FfmpegName}")" @bind-Value="mapping.FriendlyName" placeholder="e.g. Transmission 1" /></div>
            <div class="form-group"><label>Automatic-routing group</label><InputText aria-label="@($"Port group for {port.FfmpegName}")" @bind-Value="mapping.PortGroup" placeholder="e.g. Transmission" /></div>
            <div class="form-group check"><InputCheckbox aria-label="@($"Reserve {port.FfmpegName} from automatic routing")" @bind-Value="mapping.Reserved" /><label>Exclude from automatic assignment</label></div>
        </div>
        @if (mapping.IsOutputPort)
        {
            <div class="standby-config">
                <div class="standby-config-head"><label class="check"><InputCheckbox aria-label="@($"Enable standby screen for {port.FfmpegName}")" @bind-Value="mapping.StandbyEnabled" /><strong>Keep standby screen on air when idle</strong></label><span class="secondary-text">The clock follows the Windows system clock; keep Windows Time synchronized to your NTP server.</span></div>
                <div class="form-grid compact">
                    <div class="form-group"><label>Standby output preset</label><select aria-label="@($"Standby preset for {port.FfmpegName}")" @bind="mapping.StandbyPresetId">@foreach(var preset in settings.Presets){<option value="@preset.Id">@preset.Name</option>}</select></div>
                    <div class="form-group"><label>Color bars</label><select aria-label="@($"Standby pattern for {port.FfmpegName}")" @bind="mapping.StandbyPattern">@foreach(var pattern in Enum.GetValues<StandbyPattern>()){<option value="@pattern">@PatternName(pattern)</option>}</select></div>
                    <div class="form-group"><label>Custom port label</label><InputText aria-label="@($"Standby label for {port.FfmpegName}")" @bind-Value="mapping.StandbyLabel" maxlength="80" placeholder="e.g. TX 1" /></div>
                    <div class="form-group wide"><label>Logo image path (optional)</label><InputText aria-label="@($"Standby logo for {port.FfmpegName}")" @bind-Value="mapping.StandbyLogoPath" placeholder="C:\BroadcastRouter\branding\logo.png" /></div>
                    <div class="form-group check"><InputCheckbox aria-label="@($"Show synchronized clock for {port.FfmpegName}")" @bind-Value="mapping.StandbyShowClock" /><label>Show HH:mm:ss clock</label></div>
                </div>
            </div>
        }
    </article>
}
@if (Coordinator.Snapshot.Ports.Count == 0) { <div class="empty-state compact">No DeckLink connectors have been discovered. Validate and rescan the DeckLink hardware first.</div> }
</div></div>

<div class="panel" id="manual"><div class="panel-head"><h2>Manual RTSP sources</h2><button class="btn small" @onclick="AddManual">Add source</button></div><div class="table-wrap"><table><thead><tr><th>On</th><th>Name</th><th>RTSP URL</th><th>Priority</th><th>Fixed output</th><th>Lock</th><th></th></tr></thead><tbody>
@foreach(var source in settings.ManualSources){<tr><td><InputCheckbox aria-label="@($"Enable manual source {source.FriendlyName}")" @bind-Value="source.Enabled" /></td><td><InputText aria-label="Manual source name" @bind-Value="source.FriendlyName" /></td><td><InputText aria-label="@($"RTSP URL for {source.FriendlyName}")" @bind-Value="source.RtspUrl" /></td><td><InputNumber aria-label="@($"Priority for {source.FriendlyName}")" @bind-Value="source.Priority" /></td><td><select aria-label="Fixed output for @source.FriendlyName" @bind="source.FixedPortId"><option value="">Automatic</option>@if(IsMissingPort(source.FixedPortId)){<option value="@source.FixedPortId">Saved output unavailable (@DeckLinkDisplayName.ShortIdentity(source.FixedPortId))</option>}@foreach(var port in OrderedPorts()){<option value="@port.StableId">@DeckLinkDisplayName.Full(port)</option>}</select></td><td><InputCheckbox aria-label="@($"Lock manual source {source.FriendlyName}")" @bind-Value="source.Locked" /></td><td><button class="btn small danger" @onclick="() => RemoveManual(source)">Remove</button></td></tr>}
</tbody></table></div></div>

<div class="panel"><div class="panel-head"><h2>LAN access and security</h2></div><div class="panel-body"><div class="notice warning">The server binds to localhost by default. Non-loopback binding is refused unless authentication is enabled. Forwarded headers are accepted only from exact trusted proxy addresses. Restart after changes. Passwords come from <span class="mono">BROADCASTROUTER_ADMIN_PASSWORD</span> and <span class="mono">BROADCASTROUTER_OPERATOR_PASSWORD</span>.</div><div class="form-grid"><div class="form-group"><label>Bind address</label><InputText aria-label="Bind address" @bind-Value="settings.Security.BindAddress" /></div><div class="form-group"><label>Port</label><InputNumber aria-label="Listening port" @bind-Value="settings.Security.Port" /></div><div class="form-group check"><InputCheckbox aria-label="Require login" @bind-Value="settings.Security.RequireAuthentication" /><label>Require login</label></div><div class="form-group check"><InputCheckbox aria-label="Kestrel HTTPS enabled" @bind-Value="settings.Security.HttpsEnabled" /><label>Kestrel HTTPS enabled</label></div><div class="form-group wide"><label>Allowed client networks</label><InputText aria-label="Allowed client networks" @bind-Value="settings.Security.AllowedNetworks" /></div><div class="form-group wide"><label>Trusted reverse proxies</label><InputText aria-label="Trusted reverse proxy addresses" @bind-Value="settings.Security.TrustedProxies" /><span class="secondary-text">Exact IP addresses separated by semicolons; CIDR ranges are intentionally rejected.</span></div><div class="form-group"><label>Session timeout (minutes)</label><InputNumber aria-label="Session timeout minutes" @bind-Value="settings.Security.SessionTimeoutMinutes" /></div></div></div></div>

@code {
    private OperatorSettings settings = null!; private string message = ""; private string messageClass = ""; private string retryDelays = ""; private bool saving;
    private SecuritySettings originalSecurity = null!;
    private HashSet<string> originalOutputPorts = new(StringComparer.OrdinalIgnoreCase);
    protected override void OnInitialized() { settings = Coordinator.GetSettings(); originalSecurity = CopySecurity(settings.Security); retryDelays = string.Join(",", settings.Routing.RetryDelaysSeconds); originalOutputPorts = settings.DeckLinkPortOverrides.Where(value => value.IsOutputPort).Select(value => value.StableId).ToHashSet(StringComparer.OrdinalIgnoreCase); Coordinator.Changed += BackendChanged; }
    private void AddManual() => settings.ManualSources.Add(new ManualSourceProfile());
    private IReadOnlyList<CardView> PersistentCardGroups() => Coordinator.Snapshot.Ports
        .Where(port => !string.IsNullOrWhiteSpace(port.DeviceGroupId))
        .GroupBy(port => port.DeviceGroupId!, StringComparer.OrdinalIgnoreCase)
        .Select(group => new CardView(group.Key, group.OrderBy(port => port.SubdeviceIndex).ToArray()))
        .OrderBy(card => DeckLinkDisplayName.Card(card.Ports[0]), StringComparer.OrdinalIgnoreCase)
        .ToArray();
    private DeckLinkCardOverride CardOverride(string deviceGroupId, DeckLinkPort firstPort)
    {
        var value = settings.DeckLinkCardOverrides.FirstOrDefault(x => x.DeviceGroupId.Equals(deviceGroupId, StringComparison.OrdinalIgnoreCase));
        if (value is not null) return value;
        value = new DeckLinkCardOverride { DeviceGroupId = deviceGroupId, FriendlyName = firstPort.CardFriendlyName ?? $"{firstPort.ModelName} {DeckLinkDisplayName.ShortIdentity(deviceGroupId)}" };
        settings.DeckLinkCardOverrides.Add(value);
        return value;
    }
    private DeckLinkPortOverride PortOverride(DeckLinkPort port)
    {
        var value = settings.DeckLinkPortOverrides.FirstOrDefault(x => x.StableId.Equals(port.StableId, StringComparison.OrdinalIgnoreCase));
        if (value is not null)
        {
            if (string.IsNullOrWhiteSpace(value.StandbyPresetId)) value.StandbyPresetId = settings.Presets.FirstOrDefault()?.Id ?? "";
            return value;
        }
        value = new DeckLinkPortOverride { StableId = port.StableId, FriendlyName = port.FriendlyName ?? port.FfmpegName,
            PortGroup = port.PortGroup, Reserved = port.Reserved, IsOutputPort = port.IsOutputPort,
            StandbyPresetId = settings.Presets.FirstOrDefault()?.Id ?? "", StandbyLabel = port.FriendlyName ?? port.FfmpegName };
        settings.DeckLinkPortOverrides.Add(value);
        return value;
    }
    private string PendingCardName(DeckLinkPort port) => port.DeviceGroupId is { Length: > 0 } groupId
        && settings.DeckLinkCardOverrides.FirstOrDefault(card => card.DeviceGroupId.Equals(groupId, StringComparison.OrdinalIgnoreCase)) is { } card
        && !string.IsNullOrWhiteSpace(card.FriendlyName) ? card.FriendlyName : DeckLinkDisplayName.Card(port);
    private IOrderedEnumerable<DeckLinkPort> OrderedPorts() => Coordinator.Snapshot.Ports
        .Where(port => PortOverride(port).IsOutputPort)
        .OrderBy(DeckLinkDisplayName.Card, StringComparer.OrdinalIgnoreCase)
        .ThenBy(DeckLinkDisplayName.Connector, StringComparer.OrdinalIgnoreCase);
    private bool IsMissingPort(string stableId) => !string.IsNullOrWhiteSpace(stableId) && !Coordinator.Snapshot.Ports.Any(port => port.StableId.Equals(stableId, StringComparison.OrdinalIgnoreCase) && PortOverride(port).IsOutputPort);
    private static string PatternName(StandbyPattern pattern) => pattern switch { StandbyPattern.SmpteBars => "SMPTE color bars", StandbyPattern.SmpteHdBars => "SMPTE HD color bars", StandbyPattern.TestSource => "TV test pattern", _ => "Black" };
    private async Task Save()
    {
        if (SecurityChanged() && !await JS.InvokeAsync<bool>("confirm", "Changing bind, authentication, HTTPS, allowlist, or proxy trust can interrupt or lock out remote operators after restart. Save these security changes?")) return;
        var securityChanged = SecurityChanged();
        var newlyEnabledStandby = settings.DeckLinkPortOverrides.Where(value => value.IsOutputPort && value.StandbyEnabled && !originalOutputPorts.Contains(value.StableId)).ToArray();
        if (newlyEnabledStandby.Length > 0 && !await JS.InvokeAsync<bool>("confirm", $"Saving will start an FFmpeg standby screen on {newlyEnabledStandby.Length} newly enabled output port(s) after Media Tools validation. Continue?")) return;
        saving = true;
        try { settings.Routing.RetryDelaysSeconds = retryDelays.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Select(int.Parse).ToArray(); var result = await Commands.SaveSettingsAsync(settings); settings = result.Settings; retryDelays = string.Join(",", settings.Routing.RetryDelaysSeconds); originalSecurity = CopySecurity(settings.Security); originalOutputPorts = settings.DeckLinkPortOverrides.Where(value => value.IsOutputPort).Select(value => value.StableId).ToHashSet(StringComparer.OrdinalIgnoreCase); message = $"Configuration saved and applied successfully at {result.AppliedAt.ToLocalTime():yyyy-MM-dd HH:mm:ss}. Backend revision {result.ConfigurationRevision} confirmed." + (securityChanged ? " Host/bind/security changes require a restart; routing, output-port, and standby changes do not." : " No restart is required."); messageClass = "success"; }
        catch(Exception ex) { message = ex.Message; messageClass = "danger"; }
        finally { saving = false; }
    }
    private async Task Validate() { await Save(); if(messageClass == "success") { await Commands.ExecuteAsync("rescan"); message = "Validation and hardware rescan requested."; } }
    private async Task RemoveManual(ManualSourceProfile source) { if (await JS.InvokeAsync<bool>("confirm", $"Remove manual source '{source.FriendlyName}' from the pending settings?")) settings.ManualSources.Remove(source); }
    private bool SecurityChanged() => originalSecurity.BindAddress != settings.Security.BindAddress || originalSecurity.Port != settings.Security.Port
        || originalSecurity.RequireAuthentication != settings.Security.RequireAuthentication || originalSecurity.HttpsEnabled != settings.Security.HttpsEnabled
        || originalSecurity.AllowedNetworks != settings.Security.AllowedNetworks || originalSecurity.TrustedProxies != settings.Security.TrustedProxies
        || originalSecurity.SessionTimeoutMinutes != settings.Security.SessionTimeoutMinutes;
    private static SecuritySettings CopySecurity(SecuritySettings value) => new() { BindAddress = value.BindAddress, Port = value.Port,
        RequireAuthentication = value.RequireAuthentication, HttpsEnabled = value.HttpsEnabled, AllowedNetworks = value.AllowedNetworks,
        TrustedProxies = value.TrustedProxies, SessionTimeoutMinutes = value.SessionTimeoutMinutes };
    private void BackendChanged()
    {
        var revision = Coordinator.GetSettings().ConfigurationRevision;
        if (settings is null || revision == settings.ConfigurationRevision) return;
        _ = InvokeAsync(() => { message = $"Backend configuration changed to revision {revision} while this page was open. Reload before saving; stale values will not overwrite the backend."; messageClass = "warning"; StateHasChanged(); });
    }
    public void Dispose() => Coordinator.Changed -= BackendChanged;
    private sealed record CardView(string Key, IReadOnlyList<DeckLinkPort> Ports);
}
