@page "/settings"
@attribute [Authorize(Roles = "Administrator")]
@rendermode InteractiveServer
@inject RouterCoordinator Coordinator
@inject AuthorizedRouterCommands Commands
@inject IJSRuntime JS

<PageTitle>Settings · BroadcastRouter</PageTitle>
<div class="page-head"><div><h1>Settings</h1><p class="lead">Persistent SQLite configuration, DPAPI credentials, media-tool validation, routing policy, and manual inputs.</p></div><button class="btn primary" @onclick="Save">Save settings</button></div>
@if (!string.IsNullOrWhiteSpace(message)) { <div class="notice @messageClass">@message</div> }

<div class="panel"><div class="panel-head"><h2>Operating mode</h2></div><div class="panel-body"><label class="check"><InputCheckbox aria-label="Simulation mode" @bind-Value="settings.SimulationMode" /><strong>Simulation mode</strong></label><p class="secondary-text">Turn simulation off only after selecting and validating production media tools. Changing hosting address or authentication requires an application restart.</p></div></div>

<div class="panel"><div class="panel-head"><h2>Media Tools</h2><div class="actions"><BroadcastRouter.Web.Components.Shared.StateBadge Value="Coordinator.Snapshot.ToolValidation.State" /><button class="btn small" @onclick="Validate">Validate / rescan</button></div></div><div class="panel-body">
    <div class="form-grid"><div class="form-group wide"><label>ffmpeg.exe</label><InputText aria-label="FFmpeg executable path" @bind-Value="settings.MediaTools.FfmpegPath" placeholder="C:\MediaTools\ffmpeg.exe" /></div><div class="form-group wide"><label>ffprobe.exe</label><InputText aria-label="FFprobe executable path" @bind-Value="settings.MediaTools.FfprobePath" placeholder="C:\MediaTools\ffprobe.exe" /></div><div class="form-group wide"><label>ffplay.exe (optional)</label><InputText aria-label="FFplay executable path" @bind-Value="settings.MediaTools.FfplayPath" /></div></div>
    <ul class="validation-list" style="margin-top:15px">@foreach(var finding in Coordinator.Snapshot.ToolValidation.Findings){<li class="@(finding.StartsWith("PASS") ? "pass" : finding.StartsWith("FAIL") ? "fail" : "warn")">@finding</li>}</ul>
</div></div>

<div class="panel"><div class="panel-head"><h2>Routing and recovery</h2></div><div class="panel-body"><div class="form-grid">
    <div class="form-group check"><InputCheckbox aria-label="Automatic routing enabled" @bind-Value="settings.Routing.AutomaticRoutingEnabled" /><label>Automatic routing enabled</label></div><div class="form-group"><label>Reservation grace (seconds)</label><InputNumber aria-label="Reservation grace seconds" @bind-Value="settings.Routing.ReservationGraceSeconds" /></div><div class="form-group"><label>Primary stable before restore (seconds)</label><InputNumber aria-label="Primary stable seconds" @bind-Value="settings.Routing.StableRestoreSeconds" /></div><div class="form-group"><label>First progress timeout (seconds)</label><InputNumber aria-label="First progress timeout seconds" @bind-Value="settings.Routing.FirstProgressTimeoutSeconds" /></div><div class="form-group"><label>Stall timeout (seconds)</label><InputNumber aria-label="Stall timeout seconds" @bind-Value="settings.Routing.StallTimeoutSeconds" /></div><div class="form-group"><label>Graceful stop timeout (seconds)</label><InputNumber aria-label="Graceful stop timeout seconds" @bind-Value="settings.Routing.GracefulStopSeconds" /></div><div class="form-group"><label>Maximum retry attempts</label><InputNumber aria-label="Maximum retry attempts" @bind-Value="settings.Routing.MaxRetryAttempts" /><span class="secondary-text">0 keeps retrying indefinitely; a positive cap releases unlocked outputs after exhaustion.</span></div><div class="form-group"><label>Retry delays</label><input aria-label="Retry delays in seconds" value="@retryDelays" @oninput="e => retryDelays = e.Value?.ToString() ?? retryDelays" /><span class="secondary-text">Comma-separated seconds, e.g. 1,2,5,10,20,30</span></div>
</div></div></div>

<div class="panel"><div class="panel-head"><h2>DeckLink port mappings</h2></div><div class="table-wrap"><table><thead><tr><th>Detected output</th><th>Stable ID</th><th>Operator name</th><th>Port group</th><th>Reserved</th></tr></thead><tbody>
@foreach(var port in Coordinator.Snapshot.Ports)
{
    var mapping = PortOverride(port);
    <tr><td>@port.FfmpegName<span class="secondary-text">@port.ModelName</span></td><td class="mono">@port.StableId</td><td><InputText aria-label="@($"Operator name for {port.FfmpegName}")" @bind-Value="mapping.FriendlyName" /></td><td><InputText aria-label="@($"Port group for {port.FfmpegName}")" @bind-Value="mapping.PortGroup" placeholder="e.g. Transmission" /></td><td><InputCheckbox aria-label="@($"Reserve {port.FfmpegName} from automatic routing")" @bind-Value="mapping.Reserved" /></td></tr>
}
</tbody></table></div></div>

<div class="panel" id="manual"><div class="panel-head"><h2>Manual RTSP sources</h2><button class="btn small" @onclick="AddManual">Add source</button></div><div class="table-wrap"><table><thead><tr><th>On</th><th>Name</th><th>RTSP URL</th><th>Priority</th><th>Fixed output</th><th>Lock</th><th></th></tr></thead><tbody>
@foreach(var source in settings.ManualSources){<tr><td><InputCheckbox aria-label="@($"Enable manual source {source.FriendlyName}")" @bind-Value="source.Enabled" /></td><td><InputText aria-label="Manual source name" @bind-Value="source.FriendlyName" /></td><td><InputText aria-label="@($"RTSP URL for {source.FriendlyName}")" @bind-Value="source.RtspUrl" /></td><td><InputNumber aria-label="@($"Priority for {source.FriendlyName}")" @bind-Value="source.Priority" /></td><td><select aria-label="Fixed output for @source.FriendlyName" @bind="source.FixedPortId"><option value="">Automatic</option>@foreach(var port in Coordinator.Snapshot.Ports){<option value="@port.StableId">@(port.FriendlyName ?? port.FfmpegName)</option>}</select></td><td><InputCheckbox aria-label="@($"Lock manual source {source.FriendlyName}")" @bind-Value="source.Locked" /></td><td><button class="btn small danger" @onclick="() => RemoveManual(source)">Remove</button></td></tr>}
</tbody></table></div></div>

<div class="panel"><div class="panel-head"><h2>LAN access and security</h2></div><div class="panel-body"><div class="notice warning">The server binds to localhost by default. Non-loopback binding is refused unless authentication is enabled. Forwarded headers are accepted only from exact trusted proxy addresses. Restart after changes. Passwords come from <span class="mono">BROADCASTROUTER_ADMIN_PASSWORD</span> and <span class="mono">BROADCASTROUTER_OPERATOR_PASSWORD</span>.</div><div class="form-grid"><div class="form-group"><label>Bind address</label><InputText aria-label="Bind address" @bind-Value="settings.Security.BindAddress" /></div><div class="form-group"><label>Port</label><InputNumber aria-label="Listening port" @bind-Value="settings.Security.Port" /></div><div class="form-group check"><InputCheckbox aria-label="Require login" @bind-Value="settings.Security.RequireAuthentication" /><label>Require login</label></div><div class="form-group check"><InputCheckbox aria-label="Kestrel HTTPS enabled" @bind-Value="settings.Security.HttpsEnabled" /><label>Kestrel HTTPS enabled</label></div><div class="form-group wide"><label>Allowed client networks</label><InputText aria-label="Allowed client networks" @bind-Value="settings.Security.AllowedNetworks" /></div><div class="form-group wide"><label>Trusted reverse proxies</label><InputText aria-label="Trusted reverse proxy addresses" @bind-Value="settings.Security.TrustedProxies" /><span class="secondary-text">Exact IP addresses separated by semicolons; CIDR ranges are intentionally rejected.</span></div><div class="form-group"><label>Session timeout (minutes)</label><InputNumber aria-label="Session timeout minutes" @bind-Value="settings.Security.SessionTimeoutMinutes" /></div></div></div></div>

@code {
    private OperatorSettings settings = null!; private string message = ""; private string messageClass = ""; private string retryDelays = "";
    private SecuritySettings originalSecurity = null!;
    protected override void OnInitialized() { settings = Coordinator.GetSettings(); originalSecurity = CopySecurity(settings.Security); retryDelays = string.Join(",", settings.Routing.RetryDelaysSeconds); }
    private void AddManual() => settings.ManualSources.Add(new ManualSourceProfile());
    private DeckLinkPortOverride PortOverride(DeckLinkPort port)
    {
        var value = settings.DeckLinkPortOverrides.FirstOrDefault(x => x.StableId.Equals(port.StableId, StringComparison.OrdinalIgnoreCase));
        if (value is not null) return value;
        value = new DeckLinkPortOverride { StableId = port.StableId, FriendlyName = port.FriendlyName ?? port.FfmpegName, PortGroup = port.PortGroup, Reserved = port.Reserved };
        settings.DeckLinkPortOverrides.Add(value);
        return value;
    }
    private async Task Save()
    {
        if (SecurityChanged() && !await JS.InvokeAsync<bool>("confirm", "Changing bind, authentication, HTTPS, allowlist, or proxy trust can interrupt or lock out remote operators after restart. Save these security changes?")) return;
        try { settings.Routing.RetryDelaysSeconds = retryDelays.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Select(int.Parse).ToArray(); await Coordinator.SaveSettingsAsync(settings); originalSecurity = CopySecurity(settings.Security); message = "Settings saved to SQLite. Host/bind/security changes take effect after restart."; messageClass = "success"; }
        catch(Exception ex) { message = ex.Message; messageClass = "danger"; }
    }
    private async Task Validate() { await Save(); if(messageClass == "success") { await Commands.ExecuteAsync("rescan"); message = "Validation and hardware rescan requested."; } }
    private async Task RemoveManual(ManualSourceProfile source) { if (await JS.InvokeAsync<bool>("confirm", $"Remove manual source '{source.FriendlyName}' from the pending settings?")) settings.ManualSources.Remove(source); }
    private bool SecurityChanged() => originalSecurity.BindAddress != settings.Security.BindAddress || originalSecurity.Port != settings.Security.Port
        || originalSecurity.RequireAuthentication != settings.Security.RequireAuthentication || originalSecurity.HttpsEnabled != settings.Security.HttpsEnabled
        || originalSecurity.AllowedNetworks != settings.Security.AllowedNetworks || originalSecurity.TrustedProxies != settings.Security.TrustedProxies
        || originalSecurity.SessionTimeoutMinutes != settings.Security.SessionTimeoutMinutes;
    private static SecuritySettings CopySecurity(SecuritySettings value) => new() { BindAddress = value.BindAddress, Port = value.Port,
        RequireAuthentication = value.RequireAuthentication, HttpsEnabled = value.HttpsEnabled, AllowedNetworks = value.AllowedNetworks,
        TrustedProxies = value.TrustedProxies, SessionTimeoutMinutes = value.SessionTimeoutMinutes };
}
