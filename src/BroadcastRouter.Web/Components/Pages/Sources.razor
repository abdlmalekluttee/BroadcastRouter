@page "/sources"
@using BroadcastRouter.Application
@inject RouterCoordinator Coordinator
@inject AuthorizedRouterCommands Commands
@inject BrowserPreviewSupervisor PreviewSupervisor
@inject AuthorizedPreviewCommands PreviewCommands
@inject OperatorErrorMessage OperatorErrors
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Sources · BroadcastRouter</PageTitle>
<div class="page-head"><div><h1>Sources</h1><p class="lead">Wowza-discovered publishers and explicitly configured RTSP inputs.</p></div><AuthorizeView Roles="Administrator"><Authorized><div class="actions"><button class="btn" disabled="@discoveryBusy" @onclick="RefreshDiscovery">@(discoveryBusy ? "Refreshing…" : "Refresh discovery")</button><a class="btn" href="/settings#manual">Add manual RTSP</a></div></Authorized></AuthorizeView></div>
<NoticeBoard Severity="danger" @bind-Message="error" />
<NoticeBoard Severity="success" @bind-Message="commandMessage" />
<div class="filter-bar" role="search">
    <label class="filter-search"><span>Filter sources</span><input data-operator-filter aria-label="Filter sources by name or ID" value="@Query" @oninput="UpdateQuery" placeholder="Name or source ID" /></label>
    <div class="filter-chips" aria-label="Filter sources by state">
        @foreach (var option in SourceFilterOptions)
        {
            <button type="button" class="filter-chip @(StateFilter == option.Value ? "active" : "")" aria-pressed="@(StateFilter == option.Value)" @onclick="() => SetStateFilter(option.Value)">@option.Label</button>
        }
    </div>
</div>
<div class="panel preview-panel">
    <div class="panel-head"><div><h2>Embedded browser preview</h2><span class="secondary-text">A compact 720×450 low-latency player stays inside this page. The audio VU meter is rendered into the video, with confidence audio controlled from the player.</span></div><div class="actions"><BroadcastRouter.Web.Components.Shared.StateBadge Value="preview.State" />@if(preview.State is PreviewState.Running or PreviewState.Starting){<button class="btn danger" disabled="@previewBusy" @onclick="StopPreview">Stop preview</button>}</div></div>
    <div class="preview-monitor">
        <div class="preview-player-column">
            @if (preview.State == PreviewState.Running && !string.IsNullOrWhiteSpace(preview.StreamToken))
            {
                <div class="preview-player-shell">
                    <video @key="preview.StreamToken" class="preview-video" controls autoplay playsinline preload="none" aria-label="Live source preview">
                        <source src="@PreviewStreamUrl()" type="video/mp4" />
                        This browser cannot play the embedded H.264 preview.
                    </video>
                </div>
                <div class="preview-audio-hint">Use the player controls to mute, unmute, or adjust confidence audio.</div>
            }
            else
            {
                <div class="preview-screen">
                    <div class="preview-screen-content"><h3>@(preview.SourceName ?? "No source selected")</h3><p>@preview.PlaybackStatistics</p></div>
                </div>
            }
        </div>
        <div class="preview-stat-grid">
            <div class="preview-stat"><span>State</span><strong>@preview.State</strong></div>
            <div class="preview-stat"><span>Video</span><strong>@preview.VideoSummary</strong></div>
            <div class="preview-stat"><span>Audio</span><strong>@preview.AudioSummary</strong></div>
            <div class="preview-stat"><span>Uptime</span><strong>@PreviewUptime()</strong></div>
            <div class="preview-stat"><span>Owned process</span><strong>@ProcessSummary()</strong></div>
            <div class="preview-stat"><span>VU meter</span><strong>@(preview.AudioMeterEnabled ? "Peak + dB overlay" : "No audio track")</strong></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(preview.ErrorMessage)) { <div class="notice danger preview-error">@preview.ErrorMessage</div> }
    </div>
</div>
<div class="panel"><div class="table-wrap"><table><thead><tr><th>Source</th><th>Origin</th><th>RTSP</th><th>Media</th><th>Audio</th><th>State</th><th>Priority</th><th>Last observed</th><th>Actions</th></tr></thead><tbody>
@foreach (var source in FilteredSources)
{
    var route = snapshot.Routes.FirstOrDefault(x => x.SourceId == source.Identity.Value);
    var routeAction = SourceRouteActionPolicy.Resolve(route);
    <tr><td><span class="primary-text">@source.FriendlyName</span><span class="secondary-text">@source.Identity.Value</span></td>
        <td>@source.Identity.ServerId<span class="secondary-text">@source.Identity.Application / @source.Identity.ApplicationInstance</span></td>
        <td class="mono" title="@Sanitize(source.RtspUri)">@Sanitize(source.RtspUri)</td>
        <td>@FormatVideo(source.Media)</td>
        <td>@(source.Media?.AudioCodec is null ? "None" : $"{source.Media.AudioCodec} · {source.Media.AudioSampleRate} Hz · {source.Media.AudioChannels} ch")</td>
        <td><div class="source-status-stack"><BroadcastRouter.Web.Components.Shared.StateBadge Value="SourceAvailability(source)" />@if (route?.State == RouteState.WaitingForStream) { <span class="badge warning">Waiting for stream</span> }<span class="badge @AssignmentBadgeClass(route)">@SourceAssignment(route)</span></div></td><td>@source.Priority</td><td title="@source.LastObservedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")">@OperatorTime.Relative(source.LastObservedAt)</td>
        <td><AuthorizeView Roles="Administrator"><Authorized><div class="actions">
            @if (routeAction == SourceRouteActionKind.View)
            {
                <a class="btn small primary" href="/routes" title="This source already has a @route!.State route. Open the routing matrix to control it.">View route</a>
            }
            else
            {
                <a class="btn small primary" href="/routes">Configure route</a>
            }
            <button class="btn small" disabled="@(previewBusy || source.Media is null)" title="Play an embedded browser preview with audio VU meter" @onclick='() => StartPreview(source.Identity.Value)'>Preview</button><button class="btn small" disabled="@(routeBusySource is not null)" @onclick='() => Run("reprobe", source.Identity.Value)'>Reprobe</button></div></Authorized></AuthorizeView></td></tr>
}
@if (FilteredSources.Count == 0) { <tr><td colspan="9"><div class="empty-state">@(snapshot.Sources.Count == 0 ? "No configured or discovered incoming streams. Check Wowza settings or add a manual RTSP source." : "No sources match the current filter.")</div></td></tr> }
</tbody></table></div></div>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }
    [SupplyParameterFromQuery(Name = "state")] public string? State { get; set; }
    private RouterSnapshot snapshot = null!;
    private PreviewSnapshot preview = PreviewSnapshot.Stopped;
    private string error = "";
    private string commandMessage = "";
    private bool previewBusy;
    private bool discoveryBusy;
    private string? routeBusySource;
    private string StateFilter => string.IsNullOrWhiteSpace(State) ? "all" : State.ToLowerInvariant();
    private static readonly (string Value, string Label)[] SourceFilterOptions = [("all", "All"), ("active", "Active"), ("offline", "Offline"), ("waiting", "Waiting"), ("failed", "Failed"), ("unassigned", "Unassigned")];
    private IReadOnlyList<DiscoveredSource> FilteredSources => snapshot.Sources
        .Where(source => string.IsNullOrWhiteSpace(Query) || source.FriendlyName.Contains(Query, StringComparison.OrdinalIgnoreCase) || source.Identity.Value.Contains(Query, StringComparison.OrdinalIgnoreCase))
        .Where(MatchesState)
        .OrderBy(source => source.FriendlyName, StringComparer.OrdinalIgnoreCase)
        .ToArray();
    protected override void OnInitialized() { snapshot = Coordinator.Snapshot; preview = PreviewSupervisor.Snapshot; Coordinator.Changed += Changed; PreviewSupervisor.Changed += PreviewChanged; }
    private void Changed() => _ = InvokeAsync(() => { snapshot = Coordinator.Snapshot; StateHasChanged(); });
    private void PreviewChanged() => _ = InvokeAsync(() => { preview = PreviewSupervisor.Snapshot; StateHasChanged(); });
    private bool MatchesState(DiscoveredSource source)
    {
        var route = snapshot.Routes.FirstOrDefault(value => value.SourceId == source.Identity.Value);
        return StateFilter switch
        {
            "active" => SourceAvailability(source) == "Active",
            "offline" => SourceAvailability(source) == "Offline",
            "waiting" => route?.State == RouteState.WaitingForStream,
            "failed" => route?.State == RouteState.Failed,
            "unassigned" => route is null,
            _ => true
        };
    }
    private void UpdateQuery(ChangeEventArgs args) { Query = args.Value?.ToString(); UpdateFilterAddress(); }
    private void SetStateFilter(string value) { State = value == "all" ? null : value; UpdateFilterAddress(); }
    private void UpdateFilterAddress() => Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["q"] = string.IsNullOrWhiteSpace(Query) ? null : Query, ["state"] = State }), replace: true);
    private async Task Run(string action, string id)
    {
        if (routeBusySource is not null) return;
        routeBusySource = id;
        try
        {
            error = "";
            commandMessage = "";
            await Commands.ExecuteAsync(action, id);
            snapshot = Coordinator.Snapshot;
            commandMessage = action == "start"
                ? "Route request accepted. Use View route to monitor or change the output."
                : "Source reprobe requested.";
        }
        catch(Exception ex) { error = OperatorErrors.Describe(ex, "the source command"); }
        finally { routeBusySource = null; }
    }
    private async Task RefreshDiscovery()
    {
        if (discoveryBusy) return;
        discoveryBusy = true;
        try
        {
            error = "";
            commandMessage = "Source discovery request received by the server…";
            await Commands.ExecuteAsync("refresh-sources");
            snapshot = Coordinator.Snapshot;
            commandMessage = $"Source discovery completed and confirmed by the server. {snapshot.Sources.Count} incoming {(snapshot.Sources.Count == 1 ? "stream is" : "streams are")} visible.";
        }
        catch (Exception ex) { error = OperatorErrors.Describe(ex, "source discovery"); commandMessage = ""; }
        finally { discoveryBusy = false; }
    }
    private async Task StartPreview(string id)
    {
        if (previewBusy) return;
        previewBusy = true;
        try { error = ""; await PreviewCommands.StartAsync(id); preview = PreviewSupervisor.Snapshot; }
        catch(Exception ex) { error = OperatorErrors.Describe(ex, "starting the browser preview"); }
        finally { previewBusy = false; }
    }
    private async Task StopPreview()
    {
        if (previewBusy) return;
        previewBusy = true;
        try { error = ""; await PreviewCommands.StopAsync(); preview = PreviewSupervisor.Snapshot; }
        catch(Exception ex) { error = OperatorErrors.Describe(ex, "stopping the browser preview"); }
        finally { previewBusy = false; }
    }
    private string PreviewUptime() => preview.StartedAt is null ? "—" : FormatDuration(DateTimeOffset.UtcNow - preview.StartedAt.Value);
    private string ProcessSummary() => preview.ProducerProcessId is null ? "—" : $"FFmpeg {preview.ProducerProcessId}";
    private string PreviewStreamUrl() => $"/preview/stream/{preview.StreamToken}";
    private static string FormatDuration(TimeSpan value) => value.TotalHours >= 1 ? $"{(int)value.TotalHours:00}:{value.Minutes:00}:{value.Seconds:00}" : $"{value.Minutes:00}:{value.Seconds:00}";
    public void Dispose() { Coordinator.Changed -= Changed; PreviewSupervisor.Changed -= PreviewChanged; }
    private static string Sanitize(Uri value) => LogRedactor.RedactForDiagnostics(value.AbsoluteUri);
    private static string FormatRate(MediaProperties media) => media.Interlaced is null
        ? $"{media.FramesPerSecond:0.##} fps"
        : $"{media.FramesPerSecond:0.##}{(media.Interlaced.Value ? "i" : "p")}";
    private static string FormatVideo(MediaProperties? media) => media switch
    {
        null => "—",
        { HasUsableVideo: false, AudioCodec: not null } => "Generated black · audio-led input",
        _ => $"{media.VideoCodec} · {media.Width}×{media.Height} · {FormatRate(media)}"
    };
    private static string SourceAvailability(DiscoveredSource source) => source.State switch
    {
        SourceState.Ready or SourceState.Running or SourceState.PublisherActive => "Active",
        SourceState.PublisherDisconnected or SourceState.RtspUnavailable or SourceState.Disabled => "Offline",
        _ => source.State.ToString()
    };
    private static string SourceAssignment(RuntimeRoute? route) => route switch
    {
        null => "Unassigned",
        { FailureCategory: "RoutingConflict" } => "Routing conflict",
        { AssignmentMode: AssignmentMode.Preconfigured or AssignmentMode.Fixed or AssignmentMode.Rule } => "Preconfigured",
        { AssignmentMode: AssignmentMode.Manual } => "Manually assigned",
        { AssignmentMode: AssignmentMode.Automatic } => "Automatically assigned",
        _ => "Unassigned"
    };
    private static string AssignmentBadgeClass(RuntimeRoute? route) => route switch
    {
        { FailureCategory: "RoutingConflict" } => "danger",
        { AssignmentMode: AssignmentMode.Preconfigured or AssignmentMode.Fixed or AssignmentMode.Rule } => "preconfigured",
        { AssignmentMode: AssignmentMode.Manual } => "manual",
        { AssignmentMode: AssignmentMode.Automatic } => "automatic",
        _ => "unassigned"
    };
}
