@inherits LayoutComponentBase
@inject RouterCoordinator Coordinator
@implements IDisposable

<div class="shell br-shell page">
    <dialog id="br-shortcuts" class="shortcut-sheet">
        <div class="panel-head"><h2>Keyboard shortcuts</h2><form method="dialog"><button class="btn small" aria-label="Close keyboard shortcuts">Close</button></form></div>
        <div class="panel-body shortcut-list"><span><kbd>/</kbd> Focus page filter</span><span><kbd>g</kbd> then <kbd>d</kbd> Dashboard</span><span><kbd>g</kbd> then <kbd>r</kbd> Routes</span><span><kbd>g</kbd> then <kbd>s</kbd> Sources</span><span><kbd>g</kbd> then <kbd>o</kbd> Outputs</span><span><kbd>g</kbd> then <kbd>l</kbd> Logs</span><span><kbd>?</kbd> Show shortcuts</span><span><kbd>Esc</kbd> Close dialog or panel</span></div>
    </dialog>
    <aside class="sidebar br-sidebar navbar navbar-vertical navbar-expand-lg" data-bs-theme="dark" aria-label="Primary navigation">
        <div class="container-fluid br-sidebar-inner">
            <div class="br-brand-row">
                <a class="brand navbar-brand navbar-brand-autodark" href="/" aria-label="BroadcastRouter dashboard">
                    <span class="brand-mark"><img src="images/broadcastrouter-logo-64.png" alt="" /></span>
                    <span class="br-brand-copy"><strong>BroadcastRouter</strong><small>DeckLink control</small></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#br-navigation" aria-controls="br-navigation" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>

            <NavMenu />
        </div>
    </aside>
    <div class="br-main">
        <header class="topbar br-topbar navbar navbar-expand-md d-print-none">
            <div class="br-runtime-status">
                <span class="br-runtime-icon"><img src="vendor/tabler-icons/3.46.0/activity-heartbeat.svg" alt="" /></span>
                <span><strong role="status" aria-live="polite">@snapshot.StatusMessage</strong><small aria-hidden="true">Last update @snapshot.UpdatedAt.ToLocalTime().ToString("HH:mm:ss")</small></span>
            </div>
            <div class="br-topbar-right">
                <div class="br-environment @EnvironmentClass" aria-label="Runtime environment: @EnvironmentLabel">
                    <img src="vendor/tabler-icons/3.46.0/@EnvironmentIcon" alt="" />
                    <span>@EnvironmentLabel</span>
                </div>
                <div class="system-stats br-system-stats"><span class="br-stat-cpu"><small>CPU</small> @snapshot.CpuPercent.ToString("0.0")%</span><span class="br-stat-mem"><small>Memory</small> @FormatBytes(snapshot.WorkingSetBytes)</span><span class="br-stat-onair"><small>On air</small> @snapshot.Routes.Count(x => x.State == RouteState.Running)</span>
                <AuthorizeView><Authorized>
                    @if (Coordinator.RequiresAuthentication)
                    {
                        <form method="post" action="/auth/logout"><AntiforgeryToken /><button class="btn small br-sign-out" type="submit"><img src="vendor/tabler-icons/3.46.0/logout.svg" alt="" /> Sign out</button></form>
                    }
                </Authorized></AuthorizeView>
                </div>
            </div>
        </header>
        <main class="br-page-wrapper page-wrapper">
            <section class="content br-content container-xl">@Body</section>
        </main>
    </div>
</div>

@code {
    private RouterSnapshot snapshot = null!;
    protected override void OnInitialized() { snapshot = Coordinator.Snapshot; Coordinator.Changed += OnChanged; }
    private void OnChanged() => _ = InvokeAsync(() => { snapshot = Coordinator.Snapshot; StateHasChanged(); });
    public void Dispose() => Coordinator.Changed -= OnChanged;
    private static string FormatBytes(long value) => $"{value / 1024d / 1024d:0} MB";
    private string EnvironmentLabel => snapshot.EmergencyStopped ? "Emergency stop" : snapshot.SimulationMode ? "Simulation" : "Production";
    private string EnvironmentClass => snapshot.EmergencyStopped ? "danger" : snapshot.SimulationMode ? "warning" : "production";
    private string EnvironmentIcon => snapshot.SimulationMode ? "broadcast.svg" : "activity-heartbeat.svg";
}
