<span class="badge @Css">@Text</span>

@code {
    [Parameter, EditorRequired] public object Value { get; set; } = "";
    private string Text => Display(Value.ToString());
    private string Css => Text.ToLowerInvariant() switch
    {
        "active" or "running" or "ready" or "valid" or "available" or "live" => "success",
        "offline" or "publisher disconnected" or "rtsp unavailable" or "released" or "disabled" or "ignored" => "offline",
        "starting" or "probing" or "reserved" or "reconnecting" or "waiting for port"
            or "waiting for stream" or "known" or "discovered" or "publisher active" => "warning",
        "failed" or "stalled" or "video stalled" or "invalid" or "unavailable" or "unsupported media"
            or "routing conflict" => "danger",
        "audio only" => "accent",
        "fallback" => "accent",
        _ => "neutral"
    };
    private static string Display(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "Unknown";
        if (value.Contains(' ')) return value;
        return System.Text.RegularExpressions.Regex.Replace(value, "(?<!^)([A-Z])", " $1");
    }
}
