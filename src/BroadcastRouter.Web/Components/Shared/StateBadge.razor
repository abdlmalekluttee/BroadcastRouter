<span class="badge @Css">@Text</span>

@code {
    [Parameter, EditorRequired] public object Value { get; set; } = "";
    private string Text => Value.ToString() ?? "Unknown";
    private string Css => Text.ToLowerInvariant() switch
    {
        "active" or "running" or "ready" or "valid" or "available" or "live" => "success",
        "offline" or "publisherdisconnected" or "rtspunavailable" or "released" or "disabled" => "offline",
        "starting" or "probing" or "reserved" or "reconnecting" or "waitingforport"
            or "waiting for stream" or "waitingforstream" => "warning",
        "failed" or "stalled" or "invalid" or "unavailable" or "unsupportedmedia"
            or "routing conflict" => "danger",
        "fallback" => "accent",
        _ => "neutral"
    };
}
